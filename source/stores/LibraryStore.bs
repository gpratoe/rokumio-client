' LibraryStore — saved content and continue-watching positions, persisted
' locally, pure logic on a registry seam like SettingsStore/AddonsStore.
'
' A real store is built over an roRegistrySection and Load()s its state on
' construction; tests pass a fake registry (or nothing, which means in-memory
' only). Save() writes the whole library as one registry key. Since the app is
' guest-only nothing syncs — this is the local mirror of the Stremio library.
'
' Ordering uses a monotonic sequence number (m.seq) instead of a wall clock: it
' is deterministic in the brs interpreter and needs no real time source. Load()
' lifts m.seq past the highest persisted record, so a fresh session keeps
' "most recent first" instead of colliding with old sequence numbers.
'
' Helpers live as instance methods: Roku scopes user-defined global functions
' per component, so a bare global called from a method that is invoked from
' another component's code would resolve to invalid (call of a non-function).

class LibraryStore
    registry as dynamic
    saved as object
    positions as object
    seq as integer

    sub new(registry = invalid as dynamic)
        m.registry = registry
        m.saved = {}
        m.positions = {}
        m.seq = 0
        m.Load()
    end sub

    ' A missing AA key reads back as invalid in BrightScript, so this stands in
    ' for roAssociativeArray.DidExist (which the brs interpreter does not
    ' implement).
    function HasKey(aa as object, key as string) as boolean
        if aa = invalid then return false
        return aa[key] <> invalid
    end function

    ' Add a series/movie to the saved library. False when already saved or the
    ' id is blank.
    function AddSaved(metaId as string, metaType as string, name as string, poster = "" as string) as boolean
        if metaId = "" then return false
        if m.HasKey(m.saved, metaId) then return false
        m.saved[metaId] = {
            metaId: metaId
            metaType: metaType
            name: name
            poster: poster
            seq: m.NextSeq()
        }
        m.Save()
        return true
    end function

    function RemoveSaved(metaId as string) as boolean
        if m.HasKey(m.saved, metaId)
            m.saved.Delete(metaId)
            m.Save()
            return true
        end if
        return false
    end function

    function IsSaved(metaId as string) as boolean
        return m.HasKey(m.saved, metaId)
    end function

    ' Most recently added first.
    function SavedItems() as object
        items = []
        for each metaId in m.saved
            items.Push(m.saved[metaId])
        end for
        return m.SortBySeqDesc(items)
    end function

    ' Record playback progress for a video (a movie metaId, or the
    ' "{metaId}:{season}:{episode}" id for an episode). Upserts the
    ' continue-watching entry and marks it most recent. Blank positions are
    ' ignored so a fresh screen never clears stored progress.
    sub SetPosition(videoId as string, metaId as string, metaType as string, season as integer, episode as integer, name as string, poster = "" as string, position = 0 as integer, duration = 0 as integer)
        if videoId = "" or metaId = "" then return
        m.positions[videoId] = {
            videoId: videoId
            metaId: metaId
            metaType: metaType
            season: season
            episode: episode
            name: name
            poster: poster
            position: position
            duration: duration
            seq: m.NextSeq()
        }
        m.Save()
    end sub

    function Position(videoId as string) as integer
        if m.HasKey(m.positions, videoId) then return m.positions[videoId].position
        return 0
    end function

    function IsWatching(videoId as string) as boolean
        return m.HasKey(m.positions, videoId)
    end function

    ' Entries sorted by most recently played first.
    function ContinueWatching() as object
        items = []
        for each videoId in m.positions
            items.Push(m.positions[videoId])
        end for
        return m.SortBySeqDesc(items)
    end function

    ' The most recent continue-watching entry for one series/movie, or invalid
    ' when nothing has been watched. Details uses this to resurrect a resume
    ' hint for episodes opened straight from a catalog row.
    function ResumeFor(metaId as string) as dynamic
        if metaId = "" then return invalid
        best = invalid
        for each videoId in m.positions
            entry = m.positions[videoId]
            if entry.metaId = metaId and (best = invalid or entry.seq > best.seq)
                best = entry
            end if
        end for
        return best
    end function

    function RemovePosition(videoId as string) as boolean
        if m.HasKey(m.positions, videoId)
            m.positions.Delete(videoId)
            m.Save()
            return true
        end if
        return false
    end function

    function NextSeq() as integer
        m.seq = m.seq + 1
        return m.seq
    end function

    ' Insertion sort, highest seq first. Each item lands before the first
    ' element with a smaller seq, so the result stays sorted descending.
    function SortBySeqDesc(items as object) as object
        result = []
        for each item in items
            inserted = false
            for i = 0 to result.Count() - 1
                if item.seq > result[i].seq
                    result.Unshift(item)
                    inserted = true
                    exit for
                end if
            end for
            if not inserted then result.Push(item)
        end for
        return result
    end function

    sub Save()
        if m.registry = invalid then return
        m.registry.Write("library", FormatJson({ saved: m.saved, continueWatching: m.positions }))
        m.registry.Flush()
    end sub

    sub Load()
        if m.registry = invalid then return
        raw = m.registry.Read("library")
        if raw = "" then return
        parsed = invalid
        try
            parsed = ParseJson(raw)
        catch e
            return
        end try
        if parsed = invalid then return
        if parsed.saved <> invalid and Type(parsed.saved) = "roAssociativeArray" then m.saved = parsed.saved
        if parsed.continueWatching <> invalid and Type(parsed.continueWatching) = "roAssociativeArray" then m.positions = parsed.continueWatching
        if m.FindMaxSeq() > m.seq then m.seq = m.FindMaxSeq()
    end sub

    function FindMaxSeq() as integer
        maxSeq = 0
        for each metaId in m.saved
            if m.saved[metaId].seq <> invalid and m.saved[metaId].seq > maxSeq then maxSeq = m.saved[metaId].seq
        end for
        for each videoId in m.positions
            if m.positions[videoId].seq <> invalid and m.positions[videoId].seq > maxSeq then maxSeq = m.positions[videoId].seq
        end for
        return maxSeq
    end function
end class