' PlaybackStore — stream list for a movie/episode and its resolution to a
' playable URL, against an add-on server and the dedicated streaming server.
'
' Streams(...) speaks the Stremio add-on protocol: GET
' {addonAddress}/stream/{type}/{videoId}.json returns the streams (direct URLs
' or torrent infoHashes) for that video. Resolving a torrent stream needs the
' streaming server (rokumio-service): CREATE the engine for the infoHash first,
' then serve it through the master HLS playlist. The server already transcodes
' everything to Roku's native H.264/AAC, so the client just points at
' {server}/{infoHash}/{fileIdx}/hls.m3u8. The per-quality playlists
' (stream-q-<height>.m3u8) are deferred until we need the served bitrate
' control they cost in phone-server transcode CPU.
'
' The store is stateless like CatalogStore/EpisodesStore — every call passes
' the addresses in, nothing is persisted here. Resume positions belong to
' LibraryStore.

class PlaybackStore
    transport as object

    sub new(http as object)
        m.transport = http
        m.videoExtensions = ["mkv", "mp4", "avi", "ts", "mov", "webm", "m4v", "m2ts"]
    end sub

    ' GET {address}/stream/{type}/{videoId}.json — the stream candidates for a
    ' movie or episode. The response must carry a streams array.
    function Streams(addonAddress as string, metaType as string, videoId as string) as object
        result = { ok: false, streams: invalid, error: "" }
        if addonAddress = ""
            result.error = "no addon address"
            return result
        end if
        if metaType = "" or videoId = ""
            result.error = "type or video id missing"
            return result
        end if

        url = m.transport.EndpointUrl(addonAddress, "/stream/" + metaType + "/" + videoId + ".json")
        response = m.transport.Get(url)
        if not response.ok or response.json = invalid
            result.error = response.error
            return result
        end if

        streams = response.json.streams
        if streams = invalid or Type(streams) <> "roArray"
            result.error = "stream response missing streams"
            return result
        end if

        result.streams = streams
        result.ok = true
        return result
    end function

    ' Ask the streaming server to load the engine for a torrent infoHash and
    ' pick a file. The create body forwards the stream's own fileIdx hint when
    ' the add-on provided one, otherwise the server guesses. When the server
    ' answers without a guessedFileIdx but with a file list, the largest
    ' video-named file is picked; failing that the error carries the server's
    ' returned keys so a live miswire is diagnosable. Create rides the long
    ' timeout: a cold engine fetches metadata over DHT/trackers first and can
    ' take tens of seconds. Returns the chosen file index and the file list for
    ' a UI picker.
    function CreateSession(serverAddress as string, stream as object) as object
        result = { ok: false, infoHash: "", fileIdx: 0, files: invalid, error: "" }
        if serverAddress = ""
            result.error = "no streaming server address"
            return result
        end if
        if stream = invalid or stream.infoHash = invalid or stream.infoHash = ""
            result.error = "stream has no infoHash"
            return result
        end if

        body = {}
        if stream.fileIdx <> invalid then body.guessFileIdx = stream.fileIdx
        print "[rokumio] CreateSession server='" + serverAddress + "' infoHash='" + stream.infoHash + "'"
        response = m.transport.PostLong(serverAddress + "/" + stream.infoHash + "/create", body)
        print "[rokumio]   -> ok=" + response.ok.ToStr() + " status=" + response.status.ToStr() + " error='" + response.error + "'"
        if not response.ok or response.json = invalid
            result.error = response.error
            return result
        end if

        json = response.json
        fileIdx = json.guessedFileIdx
        if fileIdx = invalid
            files = json.files
            if files <> invalid and Type(files) = "roArray" and files.Count() > 0
                fileIdx = m.LargestVideoFileIdx(files)
            end if
        end if
        if fileIdx = invalid or fileIdx < 0
            result.error = "create response missing guessedFileIdx"
            keys = m.ServerResponseKeys(json)
            if keys <> "" then result.error = result.error + " (server returned keys: " + keys + ")"
            return result
        end if

        print "[rokumio] CreateSession fileIdx=" + fileIdx.ToStr()

        result.infoHash = stream.infoHash
        result.fileIdx = fileIdx
        result.files = json.files
        result.ok = true
        return result
    end function

    ' Index of the largest video-named file in a create response's files array;
    ' -1 when nothing is usable. Webtorrent file objects carry name/length; a
    ' recognizable video extension is preferred, falling back to the largest
    ' file regardless of name.
    function LargestVideoFileIdx(files as object) as integer
        best = -1
        bestLength = -1
        for i = 0 to files.Count() - 1
            file = files[i]
            if file <> invalid and Type(file) = "roAssociativeArray"
                if m.IsVideoName(file.name) or m.IsVideoName(file.path)
                    length = 0
                    if file.length <> invalid then length = file.length
                    if length > bestLength
                        bestLength = length
                        best = i
                    end if
                end if
            end if
        end for
        if best >= 0 then return best

        best = -1
        bestLength = -1
        for i = 0 to files.Count() - 1
            file = files[i]
            if file <> invalid and Type(file) = "roAssociativeArray"
                length = 0
                if file.length <> invalid then length = file.length
                if length > bestLength
                    bestLength = length
                    best = i
                end if
            end if
        end for
        return best
    end function

    function IsVideoName(name as dynamic) as boolean
        if name = invalid or Type(name) <> "roString" then return false
        lower = LCase(name)
        for each ext in m.videoExtensions
            if lower.Right(ext.Len()) = ext then return true
        end for
        return false
    end function

    ' Comma-joined keys of a create response, for the missing-guessedFileIdx
    ' error. An empty string when there is no object to introspect.
    function ServerResponseKeys(json as object) as string
        if json = invalid or Type(json) <> "roAssociativeArray" then return ""
        keys = json.Keys()
        if keys = invalid or keys.Count() = 0 then return ""
        result = ""
        for each key in keys
            if result <> "" then result = result + ", "
            result = result + key.ToStr()
        end for
        return result
    end function

    ' Master HLS playlist URL for a created session.
    function PlaybackUrl(serverAddress as string, infoHash as string, fileIdx as integer) as string
        return serverAddress + "/" + infoHash + "/" + fileIdx.ToStr() + "/hls.m3u8"
    end function

    ' One-call resolution for a play button: a direct-URL stream plays as is; a
    ' torrent stream is created on the streaming server first, then served over
    ' HLS. Returns { ok, url, error }.
    function ResolvePlayback(serverAddress as string, stream as object) as object
        result = { ok: false, url: "", error: "" }
        if stream = invalid
            result.error = "no stream"
            return result
        end if

        print "[rokumio] ResolvePlayback server='" + serverAddress + "' infoHash='" + m.StreamInfoHash(stream) + "'"

        url = stream.url
        if url <> invalid and url.Trim() <> ""
            result.ok = true
            result.url = url.Trim()
            print "[rokumio]   -> direct url '" + result.url + "'"
            return result
        end if

        session = m.CreateSession(serverAddress, stream)
        if not session.ok
            result.error = session.error
            return result
        end if

        result.url = m.PlaybackUrl(serverAddress, session.infoHash, session.fileIdx)
        result.ok = true
        print "[rokumio]   -> hls url '" + result.url + "'"
        return result
    end function

    function StreamInfoHash(stream as object) as string
        if stream <> invalid and stream.infoHash <> invalid then return stream.infoHash.ToStr()
        return ""
    end function

    ' Liveness check for the streaming server: GET /heartbeat → { success: true }.
    function Heartbeat(serverAddress as string) as object
        result = { ok: false, alive: false, error: "" }
        if serverAddress = ""
            result.error = "no streaming server address"
            return result
        end if

        response = m.transport.Get(serverAddress + "/heartbeat")
        if response.ok and response.json <> invalid and response.json.success = true
            result.ok = true
            result.alive = true
        else
            if response.error <> "" then
                result.error = response.error
            else
                result.error = "unexpected heartbeat response"
            end if
        end if
        return result
    end function
end class
