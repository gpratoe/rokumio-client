' VideoIdCodec — the Stremio episode id convention "{imdbId}:{season}:{episode}",
' the single translator between a season+episode and the string stream add-ons
' and the account library both key on. Previously the convention lived in three
' places (EpisodesStore.ResolveVideoId, LibraryStore's EpisodeWatched inline
' build, and StremioLibraryCodec's ParseLibraryItem split); a format change
' touched in one and missed in another would silently desync the ids a series'
' ordered episode list builds from the ids watched-state queries and decodes.
' This class is the one home: Build constructs a 3-part id, Parse reads one back
' (returning invalid for anything that is not exactly 3 parts — callers
' distinguish a bare movie id from a malformed one with a colon check).
'
' Pure string logic, no Roku APIs, so it behaves identically in the interpreter
' test harness and on a device. Constructed under MainScene scope wherever a
' store new() needs it (episode ordering, watched state, wire parsing), like
' WatchedCodec — never built inside a method, or the per-component scope of
' user-defined globals would make the constructor resolve to invalid when
' invoked from a screen.

class VideoIdCodec

    ' "{seriesId}:{season}:{episode}" for a valid series episode identity.
    ' Tolerant by design: add-on meta is untrusted, so missing/invalid
    ' seriesId/season/episode degrades to "" instead of throwing at a typed
    ' parameter boundary or on .ToStr(). Season/episode must be integer values.
    function Build(seriesId as dynamic, season as dynamic, episode as dynamic) as string
        id = m.AsSeriesId(seriesId)
        s = m.AsEpisodeInt(season)
        e = m.AsEpisodeInt(episode)
        if id = "" or s = invalid or e = invalid then return ""
        return id + ":" + s.ToStr() + ":" + e.ToStr()
    end function

    ' { season, episode } for a well-formed 3-part episode id, invalid for
    ' anything else — a bare movie id has one part, and every malformed count
    ' (2, 4, …) also reads as invalid. The movie-vs-junk distinction is the
    ' caller's: after Parse returns invalid, a colon in the id means malformed.
    function Parse(videoId as dynamic) as dynamic
        if GetInterface(videoId, "ifString") = invalid then return invalid
        parts = videoId.Split(":")
        if parts.Count() <> 3 then return invalid
        return {
            season: parts[1].ToInt()
            episode: parts[2].ToInt()
        }
    end function

    ' Canonical id for an episode/video object, following Stremio's model:
    ' prefer the video's own id when present, else derive from seriesId +
    ' video.season + video.episode. Returns "" when no valid id can be produced.
    function FromVideo(seriesId as dynamic, video as dynamic) as string
        if video = invalid then return ""
        ownId = m.AsSeriesId(video.id)
        if ownId <> "" then return ownId
        return m.Build(seriesId, video.season, video.episode)
    end function

    ' { videoId, season, episode } for a resolvable episode object, else invalid.
    ' Season/episode prefer the object's fields when valid; if the canonical id is
    ' known but ordinals are missing/malformed, parse them from the id so callers
    ' (streams/player/progress) can keep params consistent.
    function ResolveSelection(seriesId as dynamic, video as dynamic) as dynamic
        videoId = m.FromVideo(seriesId, video)
        if videoId = "" then return invalid
        season = invalid
        episode = invalid
        if video <> invalid
            season = m.AsEpisodeInt(video.season)
            episode = m.AsEpisodeInt(video.episode)
        end if
        if season = invalid or episode = invalid
            parsed = m.Parse(videoId)
            if parsed <> invalid
                if season = invalid then season = m.AsEpisodeInt(parsed.season)
                if episode = invalid then episode = m.AsEpisodeInt(parsed.episode)
            end if
        end if
        if season = invalid then season = 0
        if episode = invalid then episode = 0
        return { videoId: videoId, season: season, episode: episode }
    end function

    function AsSeriesId(value as dynamic) as string
        if GetInterface(value, "ifString") = invalid then return ""
        return value
    end function

    function AsEpisodeInt(value as dynamic) as dynamic
        if value = invalid then return invalid
        if GetInterface(value, "ifInt") <> invalid then return value
        return invalid
    end function

end class