' Transport — synchronous roUrlTransfer wrapper.
'
' Transport is the only store that touches Roku's networking primitives. Real
' requests go through a synchronous HTTP client (roUrlTransfer GetToString /
' PostFromString); tests inject a fake client so every store, Transport itself
' included, runs in the brs interpreter with no device calls.
'
' The client seam returns a raw result { ok, status, body, error }. Transport
' normalizes that into { ok, status, json, error }: it parses the body as JSON
' and treats an unparseable body on an otherwise-successful response as a
' failure. Stores read result.json and never care where the bytes came from.

' The real client. Serializes a body assocarray to JSON and issues a blocking
' GET or POST over roUrlTransfer.
function CreateSyncHttpClient() as object
    client = {}
    client.request = function(method as string, url as string, headers = invalid as dynamic, body = invalid as dynamic) as object
        result = { ok: false, status: 0, body: "", error: "" }
        transfer = CreateObject("roUrlTransfer")
        transfer.SetUrl(url)
        if headers <> invalid then transfer.SetHeaders(headers)
        response = ""
        if method = "POST"
            payload = ""
            if body <> invalid then payload = FormatJson(body)
            response = transfer.PostFromString(payload)
        else
            response = transfer.GetToString()
        end if
        result.body = response
        result.status = transfer.GetResponseCode()
        result.ok = result.status >= 200 and result.status < 300
        if not result.ok then result.error = "HTTP " + result.status.ToStr()
        return result
    end function
    return client
end function

' Normalize a raw client result into the transport result: parse JSON when the
' body is non-empty, and demote a 2xx with a broken body to a failure.
function TransportResult(raw as object) as object
    result = {
        ok: raw.ok
        status: raw.status
        json: invalid
        error: raw.error
    }
    body = raw.body
    if body <> invalid and body <> ""
        parsed = MatchedJson(body)
        if parsed = invalid
            result.ok = false
            result.error = "invalid JSON response"
        end if
        result.json = parsed
    end if
    return result
end function

' Parse is a guard around ParseJson: the Roku runtime throws on malformed input
' rather than returning invalid, and Transport must turn that into a clean
' failure instead of a crash.
function MatchedJson(body as string) as dynamic
    try
        return ParseJson(body)
    catch e
        return invalid
    end try
end function

class Transport
    client as object

    sub new(client = invalid as dynamic)
        if client = invalid then client = CreateSyncHttpClient()
        m.client = client
    end sub

    function Get(url as string, headers = invalid as dynamic) as object
        return TransportResult(m.client.request("GET", url, headers, invalid))
    end function

    function Post(url as string, body = invalid as dynamic, headers = invalid as dynamic) as object
        return TransportResult(m.client.request("POST", url, headers, body))
    end function
end class