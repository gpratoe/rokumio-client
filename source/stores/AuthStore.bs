' AuthStore — the current session, persisted locally.
'
' Two session modes: a local "guest" session (no transport, no network call, no
' authKey — the app simply runs without an account, so nothing syncs), and a
' "stremio" session that carries the account authKey + user profile (link-code
' pairing and the account sync live in later stages). The session survives
' relaunches through the "session" key of the "auth" registry section, so
' MainScene can skip the auth screen when IsLoggedIn() is true.

class AuthStore
    registry as dynamic
    session as string
    authKey as string
    user as dynamic
    saveRefused as boolean
    saveFailureWhy as string

    sub new(registry = invalid as dynamic)
        m.registry = registry
        m.session = ""
        m.authKey = ""
        m.user = invalid
        m.saveRefused = false
        m.saveFailureWhy = ""
        m.Load()
    end sub

    ' Sign in without an account. Drops any previous account data so a guest
    ' session never carries a stale authKey or profile.
    function LoginGuest() as object
        m.session = "guest"
        m.authKey = ""
        m.user = invalid
        saved = m.Save()
        return { ok: true, session: m.session, saved: saved }
    end function

    ' Sign in to a Stremio account with a paired authKey and its user profile.
    function LoginStremio(authKey as string, user as dynamic) as object
        m.session = "stremio"
        m.authKey = authKey
        m.user = user
        saved = m.Save()
        return { ok: true, session: m.session, authKey: m.authKey, saved: saved }
    end function

    function GetSession() as string
        return m.session
    end function

    function GetAuthKey() as string
        return m.authKey
    end function

    function GetUser() as dynamic
        return m.user
    end function

    function IsLoggedIn() as boolean
        return m.session <> ""
    end function

    function Logout() as boolean
        m.session = ""
        m.authKey = ""
        m.user = invalid
        return m.Save()
    end function

    ' The part of the user profile worth persisting. The full Stremio user
    ' object can carry integration tokens, prefs and nested data we never read;
    ' storing it whole makes the session payload larger and more variable than
    ' needed. Only the fields the app uses (email for display, _id as the stable
    ' identifier) are kept. m.user stays as provided in memory for the current
    ' session.
    function SanitizedUser(user as dynamic) as dynamic
        if user = invalid or Type(user) <> "roAssociativeArray" then return invalid
        sanitized = {}
        if user._id <> invalid then sanitized._id = user._id
        if user.email <> invalid then sanitized.email = user.email
        if sanitized.Count() = 0 then return invalid
        return sanitized
    end function

    ' Writes the current session to the registry and flushes. Returns false if
    ' serialization fails or the registry refuses a write. Flush() has no return
    ' value, so failure reasons reflect the checks we can verify. A missing
    ' registry is in-memory-only mode and not a failure.
    function Save() as boolean
        if m.registry = invalid
            m.saveRefused = false
            m.saveFailureWhy = ""
            return true
        end if
        data = { session: m.session, authKey: m.authKey }
        sanitizedUser = m.SanitizedUser(m.user)
        if sanitizedUser <> invalid then data.user = sanitizedUser
        json = FormatJson(data)
        if json = invalid or json = ""
            m.saveRefused = true
            m.saveFailureWhy = "serialize"
            return false
        end if
        ok = m.registry.Write("session", json)
        m.registry.Flush()
        m.saveRefused = not ok
        if ok
            m.saveFailureWhy = ""
        else
            m.saveFailureWhy = "write"
        end if
        return ok
    end function

    ' Whether the most recent Save() failed to persist. Reset on the next
    ' successful save.
    function SaveFailed() as boolean
        return m.saveRefused
    end function

    ' The verifiable reason the last Save() failed: "serialize", "write", or ""
    ' when none.
    function SaveFailureReason() as string
        return m.saveFailureWhy
    end function

    sub Load()
        if m.registry = invalid then return
        raw = m.registry.Read("session")
        if raw = "" then return
        ' The Roku runtime throws on malformed JSON rather than returning
        ' invalid (see Transport.Parse); a corrupt session key must mean "no
        ' session", not a cold-start crash.
        parsed = invalid
        try
            parsed = ParseJson(raw)
        catch e
            return
        end try
        if parsed = invalid then return
        if parsed.session <> invalid then m.session = parsed.session
        if parsed.authKey <> invalid then m.authKey = parsed.authKey
        if parsed.user <> invalid then m.user = parsed.user
    end sub
end class