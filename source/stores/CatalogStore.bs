' CatalogStore — on-demand catalog, manifest and search against an add-on
' server. Pure transport, no state: nothing is saved, every call hits the
' add-on's HTTP API (Cinemeta and friends). Search is the add-on's search
' catalog for one type: /catalog/{type}/top/search={query}.json.

' Most metas a single catalog page may carry. Stremio catalogs page at ~50-100
' metas, but some add-ons ignore paging and return their whole library in one
' response (one real add-on sent 13,159 metas / 2.6 MB). Home builds a tile
' node per meta on the render thread, so an uncapped page froze the channel
' until Roku killed it (EXIT_SYSTEM_KILL).
const CATALOG_MAX_METAS = 100

class CatalogStore
    transport as object

    sub new(http as object)
        m.transport = http
    end sub

    ' Fetch and normalize {address}/manifest.json. Validates identity fields so
    ' a catalog-less or broken add-on is rejected early.
    function Manifest(addonAddress as string) as object
        result = { ok: false, manifest: invalid, error: "" }
        if addonAddress = ""
            result.error = "no addon address"
            return result
        end if

        response = m.transport.Get(m.transport.EndpointUrl(addonAddress, "/manifest.json"))
        if not response.ok or response.json = invalid
            result.error = response.error
            return result
        end if

        json = response.json
        ' HasText: manifest identity is stored and then read back as a string by
        ' every caller, so a numeric id or name has to be refused rather than
        ' compared — `8.1 = ""` is the Type Mismatch that took the Details screen
        ' down from the same shape in EpisodesStore. Refusing costs a spec-violating
        ' manifest its install; the alternative is a Float in an id that throws
        ' later, wherever it is used.
        if not m.HasText(json.id) or not m.HasText(json.name)
            result.error = "manifest missing id or name"
            return result
        end if

        result.manifest = {
            id: json.id
            name: json.name
            version: json.version
            types: json.types
            idPrefixes: json.idPrefixes
            catalogs: json.catalogs
            resources: json.resources
        }

        ' The boundary pass over the record this store just shaped. It runs on the
        ' RECORD, not the raw json, and that order is the guard contract: what a
        ' record keeps is decided by asking a raw value's type (AddonsStore's
        ' NormalizeResources/NormalizeCatalogNames drop or replace a name that is a
        ' number), so coercing the payload first would hand those helpers text
        ' where they are specified to see none. Everything left after shaping is
        ' what the callers read — a catalog's type/id/name and genres, a resource's
        ' name — and that is what is normalized here: at the one point it enters
        ' the app, so no reader downstream has to be defended (AddonJson.brs is the
        ' charter; checkAddonJsonContract holds its table to the reads). The guard
        ' above ran first on purpose: identity stays a real string, as the spec and
        ' the built-ins both expect.
        NormalizeAddonJson(result.manifest)

        result.ok = true
        return result
    end function

    ' Fetch one catalog row: GET {address}/catalog/{type}/{catalogId}/{extra}.json
    ' with the extra segment defaulting to "skip=0". hasMore (the Stremio "there
    ' is another skip page" flag) rides along for clients that paginate; a
    ' response without it reports false.
    function Catalog(addonAddress as string, metaType as string, catalogId as string, extra = "skip=0" as string) as object
        result = { ok: false, metas: invalid, hasMore: false, error: "" }
        if addonAddress = ""
            result.error = "no addon address"
            return result
        end if
        if metaType = "" or catalogId = ""
            result.error = "catalog type or id missing"
            return result
        end if

        url = m.transport.EndpointUrl(addonAddress, "/catalog/" + metaType + "/" + catalogId + "/" + extra + ".json")
        response = m.transport.Get(url)

        ' Cinemeta's CDN sometimes wraps a real payload in a gateway status
        ' (502/503/504) — the search endpoint in particular returns valid results
        ' on HTTP 504 from a browser, and 200 vs 504 can flip per edge + UA. A
        ' JSON body behind a gateway status is still used; a genuine failure (a
        ' non-gateway status, or an HTML error body json can't parse) fails
        ' below.
        gatewayWrapped = response.json <> invalid and (response.status = 502 or response.status = 503 or response.status = 504)
        if not response.ok and not gatewayWrapped
            result.error = response.error
            return result
        end if

        metas = response.json.metas
        if metas = invalid or Type(metas) <> "roArray"
            result.error = "catalog response missing metas"
            return result
        end if

        ' An add-on that overflows the cap is not paging, so the trimmed page is
        ' also the last one: asking for skip=N would get the same dump again.
        capped = false
        if metas.Count() > CATALOG_MAX_METAS
            capped = true
            trimmed = []
            for i = 0 to CATALOG_MAX_METAS - 1
                trimmed.Push(metas[i])
            end for
            metas = trimmed
        end if

        ' Each row is a meta the grid paints and the Details screen re-reads, so
        ' the boundary pass runs here too — a numeric imdbRating in a catalog row
        ' is the same Cinemeta payload that took Details down from the meta
        ' endpoint, one screen earlier.
        NormalizeAddonJson(metas)

        result.metas = metas
        ' Explicit boolean read of the server's flag — the chained
        ' `result.hasMore = response.json.hasMore = true` idiom is unambiguous
        ' to mishandle (it IS a comparison), so state it plainly.
        result.hasMore = (response.json.hasMore = true) and not capped
        result.ok = true
        return result
    end function

    ' Search is a catalog call against one of the add-on's search-capable
    ' catalogs. Cinemeta resolves a query as
    ' /catalog/{type}/top/search={query}.json — the "top" catalog id with
    ' "search=" as the extra segment — so the query is percent-encoded before it
    ' becomes a URL path segment. The catalog id defaults to "top" for the
    ' Cinemeta shape but is a caller argument because a search fan-out now asks
    ' each search-capable catalog the same query. Nothing is stored locally.
    function Search(addonAddress as string, metaType as string, query as string, catalogId = "top" as string) as object
        return m.Catalog(addonAddress, metaType, catalogId, "search=" + m.transport.EncodeQueryValue(query))
    end function

    ' Whether an add-on-supplied manifest field is text with something in it.
    ' An instance method rather than a shared global: Roku resolves a bare global
    ' inside a store method against the invoking component's scope, so a shared
    ' helper is not callable from here at all (see AddonsStore's header, and
    ' LibraryStore's WatchedCodec note).
    function HasText(value as dynamic) as boolean
        if GetInterface(value, "ifString") = invalid then return false
        return value <> ""
    end function
end class

