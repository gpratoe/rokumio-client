' EpisodesStore — series/movie meta and episode resolution from an add-on
' server. GetMeta talks to the add-on; the rest are pure helpers over an
' already-fetched meta so they unit-test without any transport.
'
' Video ids follow the Stremio convention "{imdbId}:{season}:{episode}" that
' stream add-ons expect, so ResolveVideoId is the bridge from
' a Details-selected episode to a Pass-2 stream lookup.

class EpisodesStore
    transport as object

    sub new(http as object)
        m.transport = http
        m.videoId = VideoIdCodec()
        ' Full series/movie metas fetched from add-ons, keyed by "type|id".
        ' Screens read them on demand so heavy payloads (a series' videos list)
        ' do not have to be copied through focus handlers and push params on every
        ' transition; Home and Details keep slim display metas for rendering.
        m.fullMetaCache = {}
    end sub

    ' Fetch {address}/meta/{type}/{id}.json. A series must carry a non-empty
    ' meta.videos array, otherwise it is rejected.
    function GetMeta(addonAddress as string, metaType as string, id as string) as object
        result = { ok: false, meta: invalid, error: "" }
        if addonAddress = ""
            result.error = "no addon address"
            return result
        end if
        if metaType = "" or id = ""
            result.error = "meta type or id missing"
            return result
        end if

        url = m.transport.EndpointUrl(addonAddress, "/meta/" + metaType + "/" + id + ".json")
        response = m.transport.Get(url)
        if not response.ok or response.json = invalid
            result.error = response.error
            return result
        end if

        meta = response.json.meta
        if meta = invalid
            result.error = "meta response missing meta"
            return result
        end if

        ' The boundary pass. This is the payload the crash came from: Cinemeta
        ' answers imdbRating with the JSON number 8.1, and NeedsMetaFetch used to
        ' compare it to "" — "Type Mismatch. Operator '=' can't be applied to
        ' 'roFloat' and 'String'". After this the hero fields are text and the
        ' comparison is string to string.
        NormalizeAddonJson(meta)

        ' Type, not `= invalid`: a `videos` that is a number or a string would
        ' reach Count() below and throw the same class of mismatch, and it is
        ' add-on JSON like everything else here.
        if metaType = "series" and (Type(meta.videos) <> "roArray" or meta.videos.Count() = 0)
            result.error = "series meta missing videos"
            return result
        end if

        result.meta = meta
        result.ok = true
        return result
    end function

    ' Sorted list of the distinct season numbers in a series meta.
    function Seasons(meta as object) as object
        seasons = []
        if meta = invalid or meta.videos = invalid then return seasons
        for each video in meta.videos
            if video.season <> invalid
                season = video.season
                found = false
                for each existing in seasons
                    if existing = season then found = true
                end for
                if not found then seasons.Push(season)
            end if
        end for
        seasons.Sort()
        return seasons
    end function

    function EpisodesForSeason(meta as object, season as integer) as object
        episodes = []
        if meta = invalid or meta.videos = invalid then return episodes
        for each video in meta.videos
            if video.season <> invalid and video.season = season then episodes.Push(video)
        end for
        return episodes
    end function

    ' The series data the Episodes screen needs, grouped in one pass over the
    ' add-on's video list: display-ordered seasons, each season's episodes,
    ' and the ordered ids the account bitfield indexes.
    '
    ' EpisodesForSeason(meta, season) is still useful for an occasional lookup,
    ' but a screen calling it once per season scans and sends the FULL series
    ' meta across the component boundary once per season. A 39-season series
    ' with 890 videos meant 39 scans and copies of those 890 records before the
    ' screen even started painting. This query builds the groups once, sorts
    ' the small distinct-season list, then derives the bitfield ids from those
    ' same groups — the order cannot drift from what the screen paints.
    '
    ' Returns { seasons, runs, orderedVideoIds }. runs is aligned with seasons;
    ' each run is { season, episodes }.
    function SeriesData(seriesId as string, meta as object) as object
        result = { seasons: [], runs: [], orderedVideoIds: [] }
        if seriesId = "" or meta = invalid or meta.videos = invalid then return result

        seasons = []
        runs = []
        runIndex = {}
        for each video in meta.videos
            if video = invalid or video.season = invalid then continue for
            season = video.season
            key = season.ToStr()
            index = runIndex[key]
            if index = invalid
                index = seasons.Count()
                runIndex[key] = index
                seasons.Push(season)
                runs.Push({ season: season, episodes: [] })
            end if
            runs[index].episodes.Push(video)
        end for

        seasons.Sort()
        orderedSeasons = m.OrderedSeasons(seasons)
        orderedRuns = []
        orderedIds = []
        for each season in orderedSeasons
            seasonRun = runs[runIndex[season.ToStr()]]
            orderedRuns.Push(seasonRun)
            if season = 0 then continue for
            for each episode in seasonRun.episodes
                if episode.episode <> invalid
                    orderedIds.Push(m.ResolveVideoId(seriesId, season, episode.episode))
                end if
            end for
        end for

        result.seasons = orderedSeasons
        result.runs = orderedRuns
        result.orderedVideoIds = orderedIds
        return result
    end function

    ' "{imdbId}:{season}:{episode}" — the video id stream add-ons resolve.
    ' Built through VideoIdCodec so the convention has one owner (the account
    ' bitfield indexes the OrderedVideoIds list, and watched-state queries key
    ' on the same string).
    function ResolveVideoId(seriesId as string, season as integer, episode as integer) as string
        return m.videoId.Build(seriesId, season, episode)
    end function

    ' Real seasons keep ascending order; season 0 (specials) is pushed to the
    ' end of the list so it never masquerades as the first broadcast season.
    function OrderedSeasons(allSeasons as object) as object
        ordered = []
        specials = []
        for each season in allSeasons
            if season = 0
                specials.Push(0)
            else
                ordered.Push(season)
            end if
        end for
        for each special in specials
            ordered.Push(special)
        end for
        return ordered
    end function

    ' The series' ordered episode-id list, "{metaId}:{season}:{episode}" per
    ' regular (non-special) episode in display order — the ordering the account
    ' watched bitfield indexes (bit i is the i-th id here), so it must never
    ' drift from what EpisodesScreen paints. Skips season 0 (specials).
    function OrderedVideoIds(seriesId as string, meta as object) as object
        ids = []
        if seriesId = "" or meta = invalid or meta.videos = invalid then return ids
        seasons = m.Seasons(meta)
        ordered = m.OrderedSeasons(seasons)
        for s = 0 to ordered.Count() - 1
            season = ordered[s]
            if season = 0 then continue for
            episodes = m.EpisodesForSeason(meta, season)
            for each ep in episodes
                if ep.episode <> invalid
                    ids.Push(m.ResolveVideoId(seriesId, season, ep.episode))
                end if
            end for
        end for
        return ids
    end function

    ' Whether a meta handed in from a list screen is too sparse to render a hero:
    ' catalog/search rows usually carry only { id, type, name, poster }, so the
    ' Detail description, rating line and background are blank. Returns false for
    ' invalid metas and metas without a fetchable id/type — those have nothing to
    ' improve by fetching.
    '
    ' Every field is asked for through HasValue/HasText, never compared raw.
    ' Add-on JSON is not obliged to honour the meta spec's types and Cinemeta does
    ' not: it answers imdbRating with the NUMBER 8.1, and `8.1 = ""` is "Type
    ' Mismatch. Operator '=' can't be applied to 'roFloat' and 'String'" — thrown
    ' straight out of the screen that asked (DetailsScreen.maybeRefreshMeta →
    ' EpisodesNeedsMetaFetch, the crash that produced this).
    '
    ' id and type want HasText, not HasValue: they become a URL path segment and a
    ' typed argument, so only an actual string can carry them — a numeric id has
    ' nothing this can improve by fetching.
    function NeedsMetaFetch(meta as object) as boolean
        if meta = invalid then return false
        if not m.HasText(meta.id) then return false
        if not m.HasText(meta.type) then return false
        fields = ["description", "releaseInfo", "imdbRating", "background", "poster"]
        for each field in fields
            if not m.HasValue(meta[field]) then return true
        end for
        return false
    end function

    ' Whether an add-on-supplied value is a value at all: absent and an empty
    ' string are not, and everything else is — a number and a container included,
    ' since both are left alone here beyond their identity. It is the question the
    ' hero fields and MergeMeta both ask, in one place, because a raw
    ' `meta.imdbRating = ""` is the crash this store already shipped once: only a
    ' value that IS a string may be compared to "", so it is the only one compared.
    ' GetInterface rather than Type(), because Type() spells the same value
    ' differently per runtime.
    '
    ' StringOf (source/util/Helpers.brs) is the coercion for *display* and cannot
    ' stand in for this: a user-defined global resolves against the invoking
    ' component's scope, so a bare StringOf() inside a store method called from
    ' another component is a call of a non-function (LibraryStore's WatchedCodec
    ' note is the same rule, from the other side).
    function HasValue(value as dynamic) as boolean
        if value = invalid then return false
        if GetInterface(value, "ifString") = invalid then return true
        return value <> ""
    end function

    ' Whether an add-on-supplied value is text with something in it. Used where the
    ' value is stored or passed on as a string — an id, a type, a date — so a
    ' number, a boolean, a container and a blank string all answer false.
    function HasText(value as dynamic) as boolean
        if GetInterface(value, "ifString") = invalid then return false
        return value <> ""
    end function

    ' Merge a freshly fetched full meta into the slim record a screen pushed in.
    ' Values the provided record already has always win, so nothing the source
    ' screen supplied is lost; invalid and blank strings give way so the fetched
    ' meta fills those gaps. Object/array fields (e.g. Cinemeta `links`) count as
    ' present and are never compared for blank-ness — see HasValue. Returns a new
    ' object — neither input is mutated.
    function MergeMeta(provided as object, fetched as object) as object
        merged = {}
        if fetched <> invalid
            for each key in fetched
                merged[key] = fetched[key]
            end for
        end if
        if provided <> invalid
            for each key in provided
                if m.HasValue(provided[key]) then merged[key] = provided[key]
            end for
        end if
        return merged
    end function

    ' Cache key for a full meta record. A blank id cannot identify a record, so
    ' it answers "" and nothing is stored or looked up under it.
    function MetaKey(metaType as dynamic, metaId as dynamic) as string
        id = ""
        if GetInterface(metaId, "ifString") <> invalid
            id = metaId
        else if metaId <> invalid
            id = metaId.ToStr()
        end if
        if id = "" then return ""
        kind = ""
        if GetInterface(metaType, "ifString") <> invalid
            kind = metaType
        else if metaType <> invalid
            kind = metaType.ToStr()
        end if
        return kind + "|" + id
    end function

    ' Remember a full meta (with its episode list) so a later screen can read it
    ' on demand instead of receiving it copied through focus and push params.
    sub CacheFullMeta(meta as object)
        if meta = invalid then return
        key = m.MetaKey(meta.type, meta.id)
        if key = "" then return
        m.fullMetaCache[key] = meta
    end sub

    ' The cached full meta for a title, or invalid when none has been fetched.
    function FullMeta(metaType as dynamic, metaId as dynamic) as object
        key = m.MetaKey(metaType, metaId)
        if key = "" then return invalid
        if not m.fullMetaCache.DoesExist(key) then return invalid
        return m.fullMetaCache[key]
    end function

    ' A display copy of a meta: everything except the episode list. Home and
    ' Details render from this so the heavy videos array does not ride through
    ' focus updates and push params; Episodes reads the full cached meta when it
    ' needs the episode list.
    function DisplayMeta(meta as object) as object
        if meta = invalid then return invalid
        out = {}
        for each key in meta
            if key <> "videos" then out[key] = meta[key]
        end for
            return out
    end function
end class
