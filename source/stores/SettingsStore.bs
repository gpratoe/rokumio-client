' SettingsStore — the app's persisted settings, pure logic on a registry seam.
'
' A real store is constructed with an roRegistrySection (session scope) and
' Load()s its values on construction; tests pass a fake registry (or nothing,
' which means in-memory only).
'
' The setters persist themselves. That is not tidiness: the setters were once
' memory-only and every caller was trusted to call Save() afterwards, and one of
' them did not. The deep-link/import entry point set the streaming server
' address and stopped there, so an address linked over ECP was used for the rest
' of the session and then gone on the next launch — a wipe with nothing on screen
' and nothing in the log, and the one report of it came long after the change
' that caused it. A setting that forgets to save is indistinguishable from a
' setting that was never set, so the saving is a property of the store rather
' than a rule every call site has to remember.
'
' Save() reports whether the registry took the write (see SaveFailed), because
' roRegistrySection.Write answers with a boolean that used to be discarded.

' saveRefused, not saveFailed: BrightScript identifiers are case-insensitive, so
' a field called saveFailed IS the SaveFailed() method below and the compiler
' rejects the class with BS1026.
class SettingsStore
    registry as dynamic
    serverAddress as string
    language as string
    audioPassthrough as boolean
    audioTransmux as boolean
    directPlayMode as string
    hiddenHomeCatalogs as object
    saveRefused as boolean

    sub new(registry = invalid as dynamic)
        m.registry = registry
        m.serverAddress = ""
        m.language = "en"
        m.audioPassthrough = false
        m.audioTransmux = false
        m.directPlayMode = "off"
        m.hiddenHomeCatalogs = []
        m.saveRefused = false
        m.Load()
    end sub

    ' Accept an http(s)://host[:port] address (optionally with a trailing slash
    ' or a path prefix), normalized to drop trailing slashes. Returns false and
    ' leaves the stored address untouched when the input is not a valid server
    ' URL.
    function SetServerAddress(url as string) as boolean
        candidate = url.Trim()
        while candidate.Right(1) = "/"
            candidate = candidate.Left(candidate.Len() - 1)
        end while
        if candidate = "" then return false

        parts = candidate.Split("://")
        if parts.Count() < 2 then return false
        if parts[0] <> "http" and parts[0] <> "https" then return false

        rest = parts[1]
        if rest = "" then return false
        host = rest
        colon = rest.InStr(":")
        if colon >= 0
            host = rest.Left(colon)
            portStr = rest.Mid(colon + 1)
            if portStr = "" then return false
            for i = 0 to portStr.Len() - 1
                ch = portStr.Mid(i, 1)
                if ch < "0" or ch > "9" then return false
            end for
        end if
        if host = "" then return false

        m.serverAddress = candidate
        m.Save()
        return true
    end function

    function GetServerAddress() as string
        return m.serverAddress
    end function

    function ServerAddressSet() as boolean
        return m.serverAddress <> ""
    end function

    ' Blank the streaming server address (the Settings screen's Clear action).
    function ClearServerAddress() as void
        m.serverAddress = ""
        m.Save()
    end function

    function SetLanguage(value as string) as boolean
        if value = "" then return false
        m.language = value
        m.Save()
        return true
    end function

    function GetLanguage() as string
        return m.language
    end function

    ' Whether the streaming server may copy the source audio instead of
    ' re-encoding it. Off by default: the device reports AC-3 and some sinks
    ' do not reproduce it, so this is the user's call, not the device's.
    function GetAudioPassthrough() as boolean
        return m.audioPassthrough
    end function

    function SetAudioPassthrough(value as boolean) as boolean
        m.audioPassthrough = value
        m.Save()
        return true
    end function

    ' Whether the streaming server may copy the audio so that THIS ROKU
    ' decodes it, rather than the sound system. Off by default and marked
    ' experimental: a Roku's own Dolby decoder inside a fragmented MP4 has not
    ' been tested on this kind of device.
    function GetAudioTransmux() as boolean
        return m.audioTransmux
    end function

    ' A catalog is shown on Home unless its stable add-on/type/catalog tuple is
    ' explicitly hidden. Keeping only exclusions means catalogs from newly
    ' installed add-ons retain the existing Home behavior and appear by default.
    function GetHiddenHomeCatalogs() as object
        return m.hiddenHomeCatalogs
    end function

    function IsHomeCatalogVisible(addonAddress as string, metaType as string, catalogId as string) as boolean
        return m.HiddenHomeCatalogIndex(addonAddress, metaType, catalogId) < 0
    end function

    ' Persist a visibility change immediately. The identity is a tuple rather
    ' than a joined string so add-on URLs or catalog ids containing separators
    ' cannot collide with another catalog.
    function SetHomeCatalogVisible(addonAddress as string, metaType as string, catalogId as string, visible as boolean) as boolean
        if addonAddress = "" or metaType = "" or catalogId = "" then return false

        index = m.HiddenHomeCatalogIndex(addonAddress, metaType, catalogId)
        if visible
            if index >= 0 then m.hiddenHomeCatalogs.Delete(index)
        else if index < 0
            m.hiddenHomeCatalogs.Push({
                addonAddress: addonAddress
                metaType: metaType
                catalogId: catalogId
            })
        end if

        m.Save()
        return true
    end function

    function HiddenHomeCatalogIndex(addonAddress as string, metaType as string, catalogId as string) as integer
        for i = 0 to m.hiddenHomeCatalogs.Count() - 1
            hiddenCatalog = m.hiddenHomeCatalogs[i]
            if hiddenCatalog <> invalid and Type(hiddenCatalog) = "roAssociativeArray"
                if hiddenCatalog.addonAddress = addonAddress and hiddenCatalog.metaType = metaType and hiddenCatalog.catalogId = catalogId then return i
            end if
        end for
        return -1
    end function

    function SetAudioTransmux(value as boolean) as boolean
        m.audioTransmux = value
        m.Save()
        return true
    end function

    ' How torrents are played, in three states:
    '   "on"   — always play the original file straight from the server
    '   "ask"  — offer the choice before every torrent play
    '   "off"  — always remux through the server's converter (the default)
    ' Anything else stored is read as the default: an unknown value must not
    ' silently turn an experimental feature fully on.
    function GetDirectPlayMode() as string
        return m.directPlayMode
    end function

    function SetDirectPlayMode(value as string) as boolean
        if value <> "on" and value <> "ask" and value <> "off" then return false
        m.directPlayMode = value
        m.Save()
        return true
    end function

    ' The registry keeps strings, so the flags go out as text. The in-memory
    ' values are booleans; this is only the wire.
    function AudioPassthroughText() as string
        if m.audioPassthrough then return "true"
        return "false"
    end function

    function AudioTransmuxText() as string
        if m.audioTransmux then return "true"
        return "false"
    end function

    function DirectPlayModeText() as string
        return m.directPlayMode
    end function

    ' Writes every field through the registry and flushes. roRegistrySection.Write
    ' answers with a boolean saying whether it took the value, and that answer
    ' used to be thrown away: a write the registry refused then flushed nothing
    ' and the setting quietly reverted on the next launch, with nothing anywhere
    ' recording that it had ever been refused. Kept as a result instead of
    ' dropped, so a caller with somewhere to show it can.
    '
    ' A missing registry is not a failure. There is nowhere to write to, which is
    ' the in-memory-only mode the store tests exercise, not an error to report.
    function Save() as boolean
        if m.registry = invalid then return true
        ok = m.registry.Write("serverAddress", m.serverAddress)
        if not m.registry.Write("language", m.language) then ok = false
        if not m.registry.Write("audioPassthrough", m.AudioPassthroughText()) then ok = false
        if not m.registry.Write("audioTransmux", m.AudioTransmuxText()) then ok = false
        if not m.registry.Write("directPlay", m.DirectPlayModeText()) then ok = false
        if not m.registry.Write("hiddenHomeCatalogs", FormatJson(m.hiddenHomeCatalogs)) then ok = false
        m.registry.Flush()
        m.saveRefused = not ok
        return ok
    end function

    ' Whether the most recent Save() was refused by the registry. Reset by the
    ' next successful save rather than latched, so a transient refusal does not
    ' report itself for the rest of the session — the setting really is safe
    ' again once a write lands.
    function SaveFailed() as boolean
        return m.saveRefused
    end function

    sub Load()
        if m.registry = invalid then return
        address = m.registry.Read("serverAddress")
        if address <> "" then m.serverAddress = address
        language = m.registry.Read("language")
        if language <> "" then m.language = language
        ' Only an explicit "true" turns it on: anything else (missing, "false",
        ' a value from a future version) leaves the default in place.
        if m.registry.Read("audioPassthrough") = "true" then m.audioPassthrough = true
        if m.registry.Read("audioTransmux") = "true" then m.audioTransmux = true
        ' The boolean this replaced wrote "true"/"false": migrate those, keep
        ' the mode strings, and let anything else fall to the default.
        storedMode = m.registry.Read("directPlay")
        if storedMode = "false"
            m.directPlayMode = "off"
        else if storedMode = "true"
            m.directPlayMode = "on"
        else if storedMode = "on" or storedMode = "ask" or storedMode = "off"
            m.directPlayMode = storedMode
        end if

        rawHomeCatalogs = m.registry.Read("hiddenHomeCatalogs")
        if rawHomeCatalogs <> ""
            parsedHomeCatalogs = invalid
            try
                parsedHomeCatalogs = ParseJson(rawHomeCatalogs)
            catch e
                parsedHomeCatalogs = invalid
            end try
            if parsedHomeCatalogs <> invalid and Type(parsedHomeCatalogs) = "roArray"
                for each hiddenCatalog in parsedHomeCatalogs
                    if hiddenCatalog = invalid or Type(hiddenCatalog) <> "roAssociativeArray" then continue for
                    if GetInterface(hiddenCatalog.addonAddress, "ifString") = invalid or hiddenCatalog.addonAddress = "" then continue for
                    if GetInterface(hiddenCatalog.metaType, "ifString") = invalid or hiddenCatalog.metaType = "" then continue for
                    if GetInterface(hiddenCatalog.catalogId, "ifString") = invalid or hiddenCatalog.catalogId = "" then continue for
                    if m.HiddenHomeCatalogIndex(hiddenCatalog.addonAddress, hiddenCatalog.metaType, hiddenCatalog.catalogId) < 0
                        m.hiddenHomeCatalogs.Push({
                            addonAddress: hiddenCatalog.addonAddress
                            metaType: hiddenCatalog.metaType
                            catalogId: hiddenCatalog.catalogId
                        })
                    end if
                end for
            end if
        end if
    end sub
end class
