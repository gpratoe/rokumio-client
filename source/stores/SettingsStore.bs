' SettingsStore — the app's persisted settings, pure logic on a registry seam.
'
' A real store is constructed with an roRegistrySection (session scope) and
' Load()s its values on construction; tests pass a fake registry (or nothing,
' which means in-memory only). Save() writes every field through the registry
' so a second instance constructed with the same registry restores the state.

class SettingsStore
    registry as dynamic
    serverAddress as string
    uiScale as integer
    language as string

    sub new(registry = invalid as dynamic)
        m.registry = registry
        m.serverAddress = ""
        m.uiScale = 100
        m.language = "en"
        m.Load()
    end sub

    ' Accept an http(s)://host[:port] address (optionally with a trailing slash
    ' or a path prefix), normalized to drop trailing slashes. Returns false and
    ' leaves the stored address untouched when the input is not a valid server
    ' URL.
    function SetServerAddress(url as string) as boolean
        candidate = url.Trim()
        while candidate.Right(1) = "/"
            candidate = candidate.Left(candidate.Len() - 1)
        end while
        if candidate = "" then return false

        parts = candidate.Split("://")
        if parts.Count() < 2 then return false
        if parts[0] <> "http" and parts[0] <> "https" then return false

        rest = parts[1]
        if rest = "" then return false
        host = rest
        colon = rest.InStr(":")
        if colon >= 0
            host = rest.Left(colon)
            portStr = rest.Mid(colon + 1)
            if portStr = "" then return false
            for i = 0 to portStr.Len() - 1
                ch = portStr.Mid(i, 1)
                if ch < "0" or ch > "9" then return false
            end for
        end if
        if host = "" then return false

        m.serverAddress = candidate
        return true
    end function

    function GetServerAddress() as string
        return m.serverAddress
    end function

    function ServerAddressSet() as boolean
        return m.serverAddress <> ""
    end function

    function SetUiScale(value as integer) as boolean
        if value < 0 or value > 200 then return false
        m.uiScale = value
        return true
    end function

    function GetUiScale() as integer
        return m.uiScale
    end function

    function SetLanguage(value as string) as boolean
        if value = "" then return false
        m.language = value
        return true
    end function

    function GetLanguage() as string
        return m.language
    end function

    sub Save()
        if m.registry = invalid then return
        m.registry.Write("serverAddress", m.serverAddress)
        m.registry.Write("uiScale", m.uiScale.ToStr())
        m.registry.Write("language", m.language)
        m.registry.Flush()
    end sub

    sub Load()
        if m.registry = invalid then return
        address = m.registry.Read("serverAddress")
        if address <> "" then m.serverAddress = address
        scale = m.registry.Read("uiScale")
        if scale <> "" then m.uiScale = scale.ToInt()
        language = m.registry.Read("language")
        if language <> "" then m.language = language
    end sub
end class