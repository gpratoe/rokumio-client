' Thin screen stack over the Scene's child components.
'
' Screens are declared declaratively as children of MainScene and looked up by
' node id. Only one is visible and focused at a time; every transition blurs
' the outgoing screen so an un-blurred list can never eat OK/arrow keys again.
' The stack also owns each screen's screenActive flag (see Screen.xml): true only
' for the interactive top, so async task handlers know when they may grab focus.
'
' Back is routed by MainScene: the top screen gets it first via OnBackPressed;
' if it returns false and there is more than one screen on the stack, this pops.

class ScreenStack
    scene as object
    entries as object

    sub new(scene as object)
        m.scene = scene
        m.entries = []
    end sub

    function count() as integer
        return m.entries.Count()
    end function

    function top() as dynamic
        if m.entries.Count() = 0 then return invalid
        return m.entries[m.entries.Count() - 1]
    end function

    function has(screenId as string) as boolean
        for each entry in m.entries
            if entry.id = screenId then return true
        end for
        return false
    end function

    sub push(screenId as string, params = invalid as dynamic, modal = false as boolean)
        ' Resolve the target first: a push to an unknown screen is a true no-op
        ' that leaves the current screen visible, focused and un-blurred. (This
        ' bit us: a bad id hid the outgoing screen before FindNode returned
        ' invalid, leaving a blank screen with the old top still on the stack.)
        node = m.scene.FindNode(screenId)
        if node = invalid then return
        m.pushNode(node, params, modal, false)
    end sub

    ' Push a screen instance the stack does not resolve by id, for a screen the
    ' caller builds itself. `destroy` hands the stack the node's whole lifetime:
    ' pop() tears it out of the tree and drops the reference, so SceneGraph
    ' destroys the component for real instead of it lingering as an orphan.
    ' A surviving component keeps everything it owns — a mid-buffer Video node's
    ' media player above all — alive behind the next screen. Static screens pass
    ' false and are never removed (see push).
    '
    ' `modal` no longer changes anything. It used to decide whether the outgoing
    ' screen was hidden, which is the one behaviour this sub no longer has, and no
    ' caller ever passed it — every push site in the app is two-argument, and the
    ' support dialog the Home rail marks `dialog = true` is intercepted by MainScene
    ' and shown as a native dialog rather than pushed through here. Left in the
    ' signature so the API does not have to change for the callers that read like
    ' they want it, but do not expect it to do anything.
    sub pushNode(node as object, params = invalid as dynamic, modal = false as boolean, destroy = true as boolean)
        if node = invalid then return
        screenId = node.id

        shown = m.top()
        if shown <> invalid
            shouldHide = false
            if modal
                shouldHide = false
            else
                incomingParent = node.getParent()
                shownParent = shown.node.getParent()
                if incomingParent <> invalid and shownParent <> invalid and incomingParent = shownParent
                    incomingIdx = -1
                    shownIdx = -2
                    count = incomingParent.getChildCount()
                    for i = 0 to count - 1
                        child = incomingParent.getChild(i)
                        if child = node then incomingIdx = i
                        if child = shown.node then shownIdx = i
                        if incomingIdx >= 0 and shownIdx >= 0 then exit for
                    end for
                    if incomingIdx < shownIdx
                        shouldHide = true
                    else
                        shouldHide = false
                    end if
                else
                    shouldHide = false
                end if
            end if
            if shouldHide
                shown.node.visible = false
            end if
            shown.node.callFunc("BlurFocus")
            shown.node.screenActive = false
        end if

        m.entries.Push({ id: screenId, node: node, destroy: destroy })
        node.visible = true
        node.screenActive = true
        node.SetFocus(true)
        node.callFunc("OnEnter", params)
    end sub

    function pop() as boolean
        if m.entries.Count() <= 1 then return false

        removed = m.entries.Pop()
        removed.node.visible = false
        removed.node.callFunc("BlurFocus")
        removed.node.callFunc("OnExit")
        removed.node.screenActive = false

        if removed.destroy
            parent = removed.node.getParent()
            if parent <> invalid then parent.RemoveChild(removed.node)
        end if
        removed.node = invalid

        shown = m.top()
        if shown <> invalid
            shown.node.visible = true
            shown.node.screenActive = true
            shown.node.SetFocus(true)
            shown.node.callFunc("OnEnter", invalid)
        end if
        return true
    end function

    function onBackPressed() as boolean
        shown = m.top()
        if shown = invalid then return false
        return shown.node.callFunc("OnBackPressed") = true
    end function

    function popTo(screenId as string) as boolean
        while m.count() > 0
            if m.top().id = screenId then return true
            if m.count() = 1 then return false
            m.pop()
        end while
        return false
    end function
end class
