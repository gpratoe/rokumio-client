<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="Screen">
    <interface>
        <!-- The one action Home reports upward: a push request. The Scene
             observes it and calls ScreenStack.push with a target + params. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             callFunc only runs for functions declared in the interface. Stores
             are class instances and cannot cross components through a field,
             so they arrive via callFunc. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="RebuildRows" />
        <function name="EnsureCurrentRows" />
        <function name="RefreshContinueWatching" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/HeroFit.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Hero.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/StreamIdentity.brs" />

    <children>
        <Rectangle id="homeBg" width="1920" height="1080" color="0x0" />
        <Timer id="heroMetaDelay" duration="0.35" repeat="false" />
        <Timer id="heroPrefetchDelay" duration="0.45" repeat="false" />
        <Timer id="heroTitleGrace" duration="0.18" repeat="false" />
        <Poster
            id="heroPoster"
            translation="[0, 0]"
            width="1920"
            height="1080"
            loadWidth="1920"
            loadHeight="1080"
            loadDisplayMode="scaleToZoom"
            opacity="1.0" />
        <Rectangle
            id="heroScrim"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x00000099" />
        <Poster
            id="heroMask"
            translation="[0, 320]"
            width="1920"
            height="760"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/mask.png" />
        <Poster
            id="heroLogo"
            translation="[162, 72]"
            width="820"
            height="460"
            loadWidth="820"
            loadHeight="460"
            loadDisplayMode="scaleToFit"
            visible="false" />
        <!-- Offscreen logo warmers: pre-decode neighbor logos after a stable dwell. -->
        <Poster id="heroLogoWarm1" translation="[-2000, -2000]" width="820" height="460" loadWidth="820" loadHeight="460" loadDisplayMode="scaleToFit" visible="false" />
        <Poster id="heroLogoWarm2" translation="[-2000, -2000]" width="820" height="460" loadWidth="820" loadHeight="460" loadDisplayMode="scaleToFit" visible="false" />
        <Label
            id="heroTitle"
            translation="[162, 112]"
            width="680"
            height="90"
            wrap="true"
            font="font:LargeBoldSystemFont" />
        <Label
            id="heroMeta"
            translation="[166, 216]"
            width="900"
            height="30"
            font="font:SmallSystemFont" />
        <Group id="heroRating" translation="[166, 256]" visible="false">
            <Poster
                id="heroImdbLogo"
                width="64"
                height="32"
                loadWidth="64"
                loadHeight="32"
                loadDisplayMode="scaleToFit"
                uri="pkg:/images/imdb.png" />
            <Label
                id="heroRatingText"
                translation="[76, 0]"
                width="110"
                height="36"
                vertAlign="center"
                font="font:LargeBoldSystemFont" />
        </Group>
        <Label
            id="heroGenres"
            translation="[166, 307]"
            width="860"
            height="32"
            font="font:SmallSystemFont" />
        <Label
            id="heroDescription"
            translation="[166, 357]"
            width="860"
            height="145"
            wrap="true"
            vertAlign="top"
            font="font:SmallSystemFont" />
        <Label
            id="homeEmpty"
            translation="[172, 570]"
            width="1500"
            height="90"
            horizAlign="center"
            vertAlign="center"
            wrap="true"
            visible="false"
            font="font:MediumSystemFont" />

        <!-- Poster rows: a single RowList owns the whole grid physics (vertical
             row scrolling/clipping, horizontal per-row tiles, row labels). Each
             item renders as a PosterTile component. Content is set in code. -->
        <RowList
            id="catalog"
            translation="[122, 570]"
            numRows="2"
            itemSize="[1780, 405]"
            itemSpacing="[0, 66]"
            rowItemSize="[[270, 405]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
        <!-- Left rail: the vertical icon menu (Search, Discover, Library,
             Add-ons, Settings, Support). Collapsed to icons; focusing it
             widens the backdrop over the grid and the focused tile shows
             its name. Tiles are RailTile children of the rail group. -->
        <Rectangle id="railBg" width="112" height="1080"/>
        <Poster
            id="railBrand"
            translation="[32, 62]"
            width="48"
            height="32"
            loadWidth="48"
            loadHeight="32"
            loadDisplayMode="limitSize"
            uri="pkg:/images/logo.png" />
        <Poster
            id="railBrandExpanded"
            translation="[83, 62]"
            width="154"
            height="32"
            loadWidth="154"
            loadHeight="32"
            loadDisplayMode="limitSize"
            opacity="0.0"
            uri="pkg:/images/logo_expanded.png" />
        <Group id="rail" translation="[0, 380]" />
        <Animation id="railBrandExpandAnim" duration="0.28" repeat="false">
            <FloatFieldInterpolator
                id="railBrandMarkExpandInterp"
                fieldToInterp="railBrand.opacity"
                key="[0.0, 1.0]"
                keyValue="[1.0, 0.0]" />
            <FloatFieldInterpolator
                id="railBrandWordmarkExpandInterp"
                fieldToInterp="railBrandExpanded.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
        </Animation>
        <Animation id="railBrandCollapseAnim" duration="0.18" repeat="false">
            <FloatFieldInterpolator
                id="railBrandMarkCollapseInterp"
                fieldToInterp="railBrand.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
            <FloatFieldInterpolator
                id="railBrandWordmarkCollapseInterp"
                fieldToInterp="railBrandExpanded.opacity"
                key="[0.0, 1.0]"
                keyValue="[1.0, 0.0]" />
        </Animation>
        <Animation id="railExpandAnim" duration="0.28" repeat="false">
            <FloatFieldInterpolator
                id="railExpandInterp"
                fieldToInterp="railBg.width"
                key="[0.0, 0.6, 1.0]"
                keyValue="[112.0, 286.0, 320.0]" />
        </Animation>
        <Animation id="railCollapseAnim" duration="0.18" repeat="false">
            <FloatFieldInterpolator
                id="railCollapseInterp"
                fieldToInterp="railBg.width"
                key="[0.0, 0.6, 1.0]"
                keyValue="[320.0, 166.0, 112.0]" />
        </Animation>
        <Animation id="heroPosterFadeAnim" duration="0.2" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator
                id="heroPosterFadeInterp"
                fieldToInterp="heroPoster.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
        </Animation>
    </children>
</component>
