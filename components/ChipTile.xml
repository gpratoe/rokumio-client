<?xml version="1.0" encoding="utf-8"?>
<component name="ChipTile" extends="Group">
    <!-- Focusable icon+label tile used by single-row RowLists: the movie
         action buttons and the series action chips. RowList drives it through
         the same read-only interface fields as PosterTile (itemContent /
         itemHasFocus / rowHasFocus). Text comes from itemContent.title; an
         optional icon comes from itemContent.icon. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/ChipTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <!-- iconBg is the only background: a square behind the icon that
             turns white on focus (icon dark on white) and stays dimmed when
             idle. Labels sit outside it, on the dark screen. -->
        <Rectangle id="iconBg" width="72" height="72" translation="[4, 4]" />
        <Poster
            id="chipIcon"
            width="48"
            height="48"
            loadWidth="48"
            loadHeight="48"
            loadDisplayMode="limitSize"
            translation="[16, 16]"
            visible="false" />
        <Label
            id="chipText"
            width="176"
            height="40"
            translation="[88, 20]"
            horizAlign="left"
            vertAlign="middle"
            font="font:MediumSystemFont"
            visible="false" />
    </children>
</component>
