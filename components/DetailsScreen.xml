<?xml version="1.0" encoding="utf-8"?>
<component name="DetailsScreen" extends="Screen">
    <interface>
        <!-- The one action Details reports upward: a push request (movie Play,
             series Resume / "Episodes" → EpisodesScreen). The Scene observes
             it and routes to the stack. Stores are class instances and cannot
             cross components through a field, so they arrive via callFunc. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Write-back packet from an add/remove toggle (stremio sessions
             only): { metaId, metaType, name, poster, added }. MainScene
             observes it and pushes to the account. -->
        <field id="libraryChange" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/HeroFit.brs" />

    <children>
        <!-- Same background-first hero as Home: source art, scrim, then a
             bottom ramp to keep the action row readable. -->
        <Rectangle id="detailsBg" width="1920" height="1080" />
        <Poster id="bgPoster" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" />
        <Rectangle id="bgScrim" width="1920" height="1080" />

        <Poster
            id="heroLogo"
            translation="[162, 72]"
            width="820"
            height="460"
            loadWidth="820"
            loadHeight="460"
            loadDisplayMode="scaleToFit"
            visible="false" />
        <Label
            id="detailName"
            translation="[162, 112]"
            width="680"
            height="90"
            wrap="true"
            font="font:LargeBoldSystemFont" />
        <Label
            id="detailType"
            translation="[166, 216]"
            width="900"
            height="30"
            font="font:SmallSystemFont" />
        <Group id="detailRating" translation="[166, 256]" visible="false">
            <Poster id="detailImdbLogo" width="64" height="32" loadWidth="64" loadHeight="32" loadDisplayMode="scaleToFit" uri="pkg:/images/imdb.png" />
            <Label id="detailRatingText" translation="[76, 0]" width="110" height="36" vertAlign="center" font="font:LargeBoldSystemFont" />
        </Group>
        <Label
            id="detailGenres"
            translation="[166, 307]"
            width="860"
            height="32"
            font="font:SmallSystemFont" />
        <Label
            id="detailDesc"
            translation="[166, 357]"
            width="860"
            height="215"
            wrap="true"
            vertAlign="top"
            font="font:SmallSystemFont" />

        <!-- The shared chips row: a ChipsRow (standalone focusable tiles,
             the rail model) — the row owns Left/Right/OK and publishes OK
             through its `selection` field, which onChipSelected dispatches. -->
        <ChipsRow id="chipsRow" translation="[162, 610]" />
    </children>
</component>
