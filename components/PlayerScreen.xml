<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="Group">
    <!-- Minimal player pushed from StreamsScreen with { stream, serverAddress,
         metaType, metaId, videoId, season, episode, position, name, poster,
         logo, ... }. The stream is resolved here (logo pulse while the torrent
         engine warms up), then playback. Pops on Back and records the watched
         position through LibraryStore.SetPosition. Native video UI is disabled
         entirely; transport (play/pause, seek, progress) lives in this screen's
         own overlay so no platform overlay can ever collide with it. OK and the
         play/pause buttons behave identically. -->
    <interface>
        <function name="SetStores" />
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
        <field id="closeRequest" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />

    <children>
        <Rectangle id="playerBg" width="1920" height="1080" color="0x000000FF" />
        <Group id="videoSurface" width="1920" height="1080" />
        <Label
            id="playerStatus"
            translation="[40, 560]"
            width="1840"
            height="44"
            font="font:MediumSystemFont"
            color="0xE9F2ECFF"
            horizAlign="center" />

        <Group id="bufferingGroup" visible="false" translation="[510, 287]">
            <Poster
                id="logoBack"
                uri=""
                width="900"
                height="506"
                opacity="0.22"
                loadDisplayMode="scaleToFit" />
            <Poster
                id="logoFront"
                uri=""
                width="900"
                height="506"
                opacity="1.0"
                loadDisplayMode="scaleToFit"
                clippingRect="[0, 0, 0, 506]" />
        </Group>

        <!-- The Stremio-style pre-buffer pulse: while the stream resolves, the
             logo behind the (empty) reveal clip beats from almost invisible to
             solid. Stopped and reset to solid the moment resolution reports in;
             the same pair then carries the buffering reveal (logoFront clipping
             from left to right as % arrives). -->
        <Animation id="resolvePulse" duration="3" repeat="true">
            <FloatFieldInterpolator
                id="resolvePulseOpacity"
                fieldToInterp="logoBack.opacity"
                key="[0.0, 0.35, 0.5, 0.65, 1.0]"
                keyValue="[0.15, 0.35, 1.0, 0.35, 0.15]"
                easeFunction="linear" />
        </Animation>

        <Group id="playerOverlay" visible="false">
            <Rectangle
                id="topScrim"
                translation="[0, 0]"
                width="1920"
                height="120"
                color="0x00000080" />
            <Label
                id="overlayTitle"
                translation="[80, 46]"
                width="1760"
                height="50"
                font="font:LargeBoldSystemFont"
                color="0xE9F2ECFF" />

            <Rectangle
                id="bottomScrim"
                translation="[0, 840]"
                width="1920"
                height="240"
                color="0x000000A0" />
            <Poster
                id="playButton"
                uri="pkg:/images/icon_play.png"
                translation="[70, 905]"
                width="80"
                height="80" />
            <Rectangle
                id="progressTrack"
                translation="[190, 924]"
                width="1640"
                height="16"
                color="0xFFFFFF26" />
            <Rectangle
                id="progressFill"
                translation="[190, 924]"
                width="0"
                height="16"
                color="0x2BD675FF" />
            <Label
                id="timeLabel"
                translation="[190, 950]"
                width="1640"
                height="34"
                horizAlign="right"
                font="font:MediumSystemFont"
                color="0x8FA399FF" />

            <Group id="seekToast" visible="false">
                <Rectangle
                    id="seekToastBg"
                    translation="[830, 808]"
                    width="260"
                    height="60"
                    color="0x000000E6" />
                <Label
                    id="seekToastText"
                    translation="[830, 820]"
                    width="260"
                    height="36"
                    horizAlign="center"
                    font="font:MediumBoldSystemFont"
                    color="0xE9F2ECFF" />
            </Group>
        </Group>

        <Timer id="overlayHideTimer" duration="5" repeat="false" />
        <Timer id="toastHideTimer" duration="1.5" repeat="false" />
        <Timer id="stopWatchdog" duration="3" repeat="false" />
    </children>
</component>
