<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="Screen">
    <!-- Minimal player pushed from StreamsScreen with { stream, serverAddress,
         metaType, metaId, videoId, season, episode, position, name, poster,
         logo, ... }. The stream is resolved here (logo pulse while the torrent
         engine warms up), then playback runs on Roku's native player chrome —
         the pause screen, seek/trick-play, and Options/captions dialog belong
         to the platform. Pops on Back and records the watched position through
         LibraryStore.SetPosition. The buffering logo is the one branded piece
         that stays.
         A static child of MainScene, reused across plays: OnBackPressed only
         records the position and declines, the stack pops, and OnExit cancels
         the resolve and sends the Video node a plain stop. The node survives the
         pop, so the next play re-arms it in CreateVideo. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <!-- Called by MainScene from the two points the add-on registry actually
             moves (the sync install loop, and a Rokumio import), so a subtitle
             provider that lands after this screen entered is still asked. See
             EnsureSubtitleProviders. -->
        <function name="EnsureSubtitleProviders" />
        <field id="watchStateUpdate" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/stores/SubtitlesStore.bs" />
    <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="playerBg" width="1920" height="1080" />
        <Video
            id="video"
            width="1920"
            height="1080"
            enableUI="true"
            enableTrickPlay="true" />
        <Label
            id="playerStatus"
            translation="[40, 560]"
            width="1840"
            height="44"
            font="font:MediumSystemFont"
            horizAlign="center" />

        <Group id="bufferingGroup" visible="false" translation="[510, 287]">
            <Poster
                id="logoBack"
                uri=""
                width="900"
                height="506"
                opacity="0.22"
                loadDisplayMode="scaleToFit" />
            <Poster
                id="logoFront"
                uri=""
                width="900"
                height="506"
                opacity="1.0"
                loadDisplayMode="scaleToFit"
                clippingRect="[0, 0, 0, 506]" />
        </Group>

        <!-- The Stremio-style pre-buffer pulse: while the stream resolves, the
             logo behind the (empty) reveal clip beats from almost invisible to
             solid. Stopped and reset to solid the moment resolution reports in;
             the same pair then carries the buffering reveal (logoFront clipping
             from left to right as % arrives). -->
        <!-- No easeFunction: the running Roku OS has no such field on
             FloatFieldInterpolator and rejects the attribute outright
             ("Tried to set nonexistent field"), so the one that was here did
             nothing but print a warning on every player screen. The default
             easing is what a logo pulse wants anyway. -->
        <Animation id="resolvePulse" duration="3" repeat="true">
            <FloatFieldInterpolator
                id="resolvePulseOpacity"
                fieldToInterp="logoBack.opacity"
                key="[0.0, 0.35, 0.5, 0.65, 1.0]"
                keyValue="[0.15, 0.35, 1.0, 0.35, 0.15]" />
        </Animation>

        <!-- A transient warning, for the one thing playback cannot fix itself:
             captions that could not be fetched. Rides above the video on a
             translucent plate so the text reads over any frame, holds for two
             seconds, then fades. Not a status line: playerStatus below is the
             play state, and a failed caption fetch would overwrite that.

             The fade is an Animation on toastGroup.opacity, which cascades to
             both children — RailTile dims its whole subtree the same way, so
             the field is one this app has already proven on device. And because
             a FloatFieldInterpolator on an OS that lacks the field would fail
             SILENTLY (the easeFunction attribute that did nothing but print a
             warning is the precedent above), toastHideTimer is armed for the
             same window and force-hides the group regardless, so a no-op
             interpolator cannot strand the label on screen over the video. -->
        <Group id="toastGroup" visible="false" translation="[210, 496]">
            <Rectangle id="toastPlate" width="1500" height="64" cornerRadius="32" />
            <Label
                id="toastLabel"
                width="1500"
                height="64"
                font="font:MediumSystemFont"
                horizAlign="center"
                vertAlign="center" />
            <Animation id="toastFade" delay="2" duration="0.5" repeat="false">
                <FloatFieldInterpolator
                    id="toastFadeOpacity"
                    fieldToInterp="toastGroup.opacity"
                    key="[0.0, 1.0]"
                    keyValue="[1.0, 0.0]" />
            </Animation>
        </Group>

        <!-- The Animation's own end is not trusted to hide anything: see above.
             2s hold + 0.5s fade + margin. Armed by ShowToast alongside the fade. -->
        <Timer id="toastHideTimer" duration="2.6" repeat="false" />

        <!-- Not cosmetic: StartPlayback hands the Video node its content and
             asks it to play from separate ticks, and this is the boundary. See
             StartPlayback for why the same tick is not good enough. -->
        <Timer id="playKick" duration="0.25" repeat="false" />
    </children>
</component>
