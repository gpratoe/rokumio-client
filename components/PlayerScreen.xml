<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="Screen">
    <!-- Minimal player pushed from StreamsScreen with { stream, serverAddress,
         metaType, metaId, videoId, season, episode, position, name, poster,
         logo, ... }. The stream is resolved here (logo pulse while the torrent
         engine warms up), then playback runs on Roku's Video node with the
         app-owned pause controls layered above it. Pops on Back and records the watched position through
         LibraryStore.SetPosition. The buffering logo is the one branded piece
         that stays.
         A static child of MainScene, reused across plays: OnBackPressed only
         records the position and declines, the stack pops, and OnExit cancels
         the resolve and sends the Video node a plain stop. The node survives the
         pop, so the next play re-arms it in CreateVideo. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <!-- Called by MainScene from the two points the add-on registry actually
             moves (the sync install loop, and a Rokumio import), so a subtitle
             provider that lands after this screen entered is still asked. See
             EnsureSubtitleProviders. -->
        <function name="EnsureSubtitleProviders" />
        <field id="watchStateUpdate" type="assocarray" alwaysNotify="true" />
        <!-- A genuine series completion publishes the next episode here. The
             Scene owns stack replacement; the player never navigates itself. -->
        <field id="playbackAction" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/stores/SubtitlesStore.bs" />
    <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/StreamIdentity.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/AddonJson.brs" />

    <children>
        <Rectangle id="playerBg" width="1920" height="1080" />
        <Video
            id="video"
            width="1920"
            height="1080"
            enableUI="false"
            enableTrickPlay="false" />
        <Label
            id="playerStatus"
            translation="[40, 812]"
            width="1840"
            height="44"
            font="font:MediumSystemFont"
            horizAlign="center" />

        <!-- Live statistics from the stock Stremio server. Kept outside the
             artwork group so it stays readable whether the title has a logo or
             only the plain player background. -->
        <Group id="torrentStatsGroup" visible="false" translation="[710, 724]">
            <Rectangle width="500" height="48" color="0x12101BCC" />
            <Label
                id="torrentStatsText"
                translation="[14, 4]"
                width="472"
                height="40"
                font="font:SmallSystemFont"
                horizAlign="center"
                vertAlign="center" />
        </Group>

        <!-- App-owned player chrome. Disabling Video's native UI makes OK pause
             reliably, so this overlay supplies the missing timeline and actions.
             Left/Right seeks while the timeline has focus; Up reaches the
             compact icon row and Down dismisses the overlay. -->
        <Group id="pauseActionsGroup" visible="false">
            <Rectangle translation="[0, 825]" width="1920" height="255" color="0x090812E8" />
            <Label id="pauseTitle" translation="[180, 880]" width="1050" height="58"
                font="font:MediumSystemFont" />
            <Group id="seekGroup" translation="[180, 990]">
                <Rectangle id="seekFocus" translation="[-18, -22]" width="1596" height="70"
                    color="0x00000000" />
                <Rectangle id="seekTrack" translation="[0, 9]" width="1560" height="8"
                    color="0x777483CC" />
                <Rectangle id="seekFill" translation="[0, 9]" width="0" height="8"
                    color="0x8C65FFFF" />
                <Rectangle id="seekKnob" translation="[-8, 1]" width="24" height="24"
                    color="0xFFFFFFFF" />
                <Label id="seekElapsed" translation="[0, 27]" width="220" height="38"
                    font="font:SmallSystemFont" />
                <Label id="seekDuration" translation="[1340, 27]" width="220" height="38"
                    font="font:SmallSystemFont" horizAlign="right" />
            </Group>
            <Group id="pauseIconRow" translation="[1325, 868]">
                <Group id="pauseResumeAction">
                    <Rectangle id="pauseResumeBg" width="78" height="78" color="0x242136F2" />
                    <Poster id="pauseResumePlayIcon" uri="pkg:/images/play.png" translation="[15, 15]" width="48" height="48"
                        loadDisplayMode="scaleToFit" blendColor="0xFFFFFFFF" />
                    <Group id="pauseResumePauseIcon" visible="false" translation="[24, 20]">
                        <Rectangle width="10" height="38" color="0xFFFFFFFF" />
                        <Rectangle translation="[20, 0]" width="10" height="38" color="0xFFFFFFFF" />
                    </Group>
                </Group>
                <Group id="pauseNextAction" translation="[108, 0]">
                    <Rectangle id="pauseNextBg" width="78" height="78" color="0x242136F2" />
                    <Poster uri="pkg:/images/arrow_right.png" translation="[9, 15]" width="48" height="48"
                        loadDisplayMode="scaleToFit" blendColor="0xFFFFFFFF" />
                    <Poster uri="pkg:/images/arrow_right.png" translation="[25, 15]" width="48" height="48"
                        loadDisplayMode="scaleToFit" blendColor="0xFFFFFFFF" />
                </Group>
                <Group id="pauseCaptionsAction" translation="[216, 0]">
                    <Rectangle id="pauseCaptionsBg" width="78" height="78" color="0x242136F2" />
                    <Label id="pauseCaptionsText" translation="[3, 18]" width="72" height="42"
                        text="CC" font="font:SmallBoldSystemFont" horizAlign="center" vertAlign="center" />
                </Group>
            </Group>
        </Group>

        <Group id="bufferingGroup" visible="false" translation="[510, 287]">
            <Poster
                id="logoBack"
                uri=""
                width="900"
                height="506"
                opacity="0.22"
                loadDisplayMode="scaleToFit" />
            <Poster
                id="logoFront"
                uri=""
                width="900"
                height="506"
                opacity="1.0"
                loadDisplayMode="scaleToFit"
                clippingRect="[0, 0, 0, 506]" />
        </Group>

        <!-- The Stremio-style pre-video pulse: while playback is being prepared
             — the resolve, a torrent engine warm-up, the caption drain — the
             logo behind the (empty) reveal clip beats from almost invisible to
             solid. It is started once on entry and runs until the platform's
             own buffering indicator takes over; nothing in between stops or
             restarts it (see StartPreVideoPulse/StopPreVideoPulse in
             PlayerScreen.brs). The same logoBack/logoFront pair then carries
             the buffering reveal (logoFront clipping from left to right as %
             arrives). -->
        <!-- No easeFunction: the running Roku OS has no such field on
             FloatFieldInterpolator and rejects the attribute outright
             ("Tried to set nonexistent field"), so the one that was here did
             nothing but print a warning on every player screen. The default
             easing is what a logo pulse wants anyway. -->
        <Animation id="preVideoPulse" duration="3" repeat="true">
            <FloatFieldInterpolator
                id="preVideoPulseOpacity"
                fieldToInterp="logoBack.opacity"
                key="[0.0, 0.35, 0.5, 0.65, 1.0]"
                keyValue="[0.15, 0.35, 1.0, 0.35, 0.15]" />
        </Animation>

        <!-- Not cosmetic: StartPlayback hands the Video node its content and
             asks it to play from separate ticks, and this is the boundary. See
             StartPlayback for why the same tick is not good enough. -->
        <Timer id="playKick" duration="0.25" repeat="false" />

        <!-- Stall recovery (see the "Stall recovery" section of PlayerScreen.brs):
             stallWatch is the 1s progress watchdog, armed by StartPlayback;
             recoverKick defers the reopened stream's play by a tick, the same
             way playKick does for the first play. -->
        <Timer id="stallWatch" duration="1" repeat="true" />
        <Timer id="recoverKick" duration="0.5" repeat="false" />
        <Timer id="playerUiTick" duration="0.5" repeat="true" />
        <Timer id="seekRepeat" duration="0.18" repeat="true" />
        <Timer id="controlsHide" duration="5" repeat="false" />
        <Timer id="nextWaitTimeout" duration="45" repeat="false" />
    </children>
</component>
