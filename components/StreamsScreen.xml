<?xml version="1.0" encoding="utf-8"?>
<component name="StreamsScreen" extends="Screen">
    <!-- Stream picker for a movie or episode, pushed with
         { addonAddress, metaType, metaId, videoId, season, episode, position,
           name, poster, logo, background } plus the panel's data the pusher
           holds (description + runtime for a movie; episodeName +
           episodeOverview for a series from EpisodesScreen). Two panes:
           - left: title (series + episode line), synopsis, and the Cinemeta
             background artwork (no poster), all from the params;
           - right: one selectable stream card per candidate, collected from
             every installed add-on that advertises the "stream" resource in
             parallel — one StreamsLoaderTask per provider, so cards appear as
             each provider resolves instead of after all of them finish.
         OK on a card resolves playback and pushes the PlayerScreen; resolution
         failures (e.g. torrent streams without a streaming server) surface in
         the status line. -->
    <interface>
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/DirectPlay.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />

    <children>
        <Rectangle id="streamBg" width="1920" height="1080" />
        <Poster id="bgPoster" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" />
        <Rectangle id="bgScrim" width="1920" height="1080" />

        <!-- Left: same hero language as Details/Home — the logo (fixed box,
             scaleToFit keeps one layout whatever the ratio), the fallback
             title when a stream has no logo, the action line, the resume
             state line, the synopsis. No poster. -->
        <Poster
            id="heroLogo"
            translation="[80, 72]"
            width="560"
            height="360"
            loadWidth="560"
            loadHeight="360"
            loadDisplayMode="scaleToFit"
            visible="false" />
        <Label
            id="headTitle"
            translation="[80, 132]"
            width="600"
            height="200"
            wrap="true"
            vertAlign="top"
            horizAlign="left"
            font="font:LargeBoldSystemFont" />
        <Label
            id="headSub"
            translation="[80, 452]"
            width="620"
            height="40"
            horizAlign="left"
            font="font:SmallSystemFont" />
        <Label
            id="resumeLine"
            translation="[80, 500]"
            width="620"
            height="36"
            wrap="true"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            visible="false" />
        <Label
            id="synopsis"
            translation="[80, 552]"
            width="600"
            height="380"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont" />
        <Label
            id="status"
            translation="[80, 975]"
            width="600"
            height="60"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont" />

        <!-- Right: provider header — centered name between the arrows, the
             segment dots centered beneath it. Arrows appear only for the
             directions the user can actually move; the name keeps its
             centered box regardless, so the row stays stable. -->
        <Poster
            id="providerPill"
            translation="[752, 76]"
            width="1096"
            height="64"
            uri="pkg:/images/provider-pill.png"
            visible="false" />
        <Poster
            id="arrowLeft"
            translation="[764, 80]"
            width="56"
            height="56"
            loadWidth="56"
            loadHeight="56"
            loadDisplayMode="limitSize"
            uri="pkg:/images/arrow_left.png"
            visible="false" />
        <Label
            id="providerName"
            translation="[832, 88]"
            width="936"
            height="40"
            horizAlign="center"
            vertAlign="center"
            font="font:LargeBoldSystemFont" />
        <Poster
            id="arrowRight"
            translation="[1780, 80]"
            width="56"
            height="56"
            loadWidth="56"
            loadHeight="56"
            loadDisplayMode="limitSize"
            uri="pkg:/images/arrow_right.png"
            visible="false" />
        <Group
            id="providerSegments"
            translation="[760, 156]" />
        <RowList
            id="streamsList"
            translation="[760, 180]"
            numRows="1"
            itemSize="[1080, 332]"
            itemSpacing="[0, 12]"
            rowItemSize="[[1080, 320]]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="StreamTile" />
        <Label
            id="streamsPlaceholder"
            translation="[760, 300]"
            width="1040"
            height="60"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:MediumSystemFont"
            visible="false" />
    </children>
</component>
