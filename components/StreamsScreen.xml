<?xml version="1.0" encoding="utf-8"?>
<component name="StreamsScreen" extends="Group">
    <!-- Stream picker for a movie or episode, pushed with
         { addonAddress, metaType, metaId, videoId, season, episode, position,
           name, poster, logo, background } plus the panel's data the pusher
           holds (description + runtime for a movie; episodeName +
           episodeOverview for a series from EpisodesScreen). Two panes:
           - left: title (series + episode line), synopsis, and the Cinemeta
             background artwork (no poster), all from the params;
           - right: one selectable stream card per candidate, collected from
             every installed add-on that advertises the "stream" resource in
             parallel — one StreamsLoaderTask per provider, so cards appear as
             each provider resolves instead of after all of them finish.
         OK on a card resolves playback and pushes the PlayerScreen; resolution
         failures (e.g. torrent streams without a streaming server) surface in
         the status line. -->
    <interface>
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <function name="SetStores" />
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamsScreen.brs" />

    <children>
        <Rectangle id="streamBg" width="1920" height="1080" color="0x0A0F0CFF" />
        <Poster id="bgPoster" width="1920" height="1080" loadDisplayMode="scaleToCrop" />
        <Rectangle id="bgScrim" width="1920" height="1080" color="0x00000099" />

        <!-- Left: title + optional episode line + synopsis. No poster. -->
        <Label
            id="headTitle"
            translation="[80, 150]"
            width="620"
            height="90"
            horizAlign="left"
            wrap="true"
            font="font:LargeBoldSystemFont"
            color="0xE9F2ECFF" />
        <Label
            id="headSub"
            translation="[80, 250]"
            width="620"
            height="40"
            font="font:MediumSystemFont"
            color="0x2BD675FF" />
        <Label
            id="synopsis"
            translation="[80, 306]"
            width="600"
            height="640"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont"
            color="0x8FA399FF" />
        <Label
            id="status"
            translation="[80, 975]"
            width="600"
            height="60"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont"
            color="0x2BD675FF" />

        <!-- Right: provider header (arrows + name + segment dots) above the
             selectable stream list. The arrows appear only for directions the
             user can actually move; the segments mark the position among the
             providers. -->
        <Poster
            id="arrowLeft"
            translation="[760, 92]"
            width="48"
            height="48"
            uri="pkg:/images/arrow-left.png"
            visible="false" />
        <Label
            id="providerName"
            translation="[824, 96]"
            width="920"
            height="40"
            horizAlign="left"
            wrap="true"
            font="font:MediumBoldSystemFont"
            color="0xE9F2ECFF" />
        <Poster
            id="arrowRight"
            translation="[1768, 92]"
            width="48"
            height="48"
            uri="pkg:/images/arrow-right.png"
            visible="false" />
        <Group
            id="providerSegments"
            translation="[760, 156]" />
        <RowList
            id="streamsList"
            translation="[760, 180]"
            numRows="1"
            itemSize="[1080, 312]"
            itemSpacing="[0, 12]"
            rowItemSize="[[1080, 300]]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="StreamTile" />
        <Label
            id="streamsPlaceholder"
            translation="[760, 300]"
            width="1040"
            height="60"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:MediumSystemFont"
            color="0x8FA399FF"
            visible="false" />
    </children>
</component>
