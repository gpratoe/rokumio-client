<?xml version="1.0" encoding="utf-8"?>
<component name="PosterTile" extends="Group">
    <!-- MarkupGrid and RowList only update item components through these
         read-only interface fields (they never touch `content` or `focused`):
         itemContent carries the tile's ContentNode, itemHasFocus marks the
         focused item, and rowHasFocus tells a whole row that its list row has
         focus. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/PosterTile.brs" />

    <children>
        <!-- tileBorder is the frame (full tile), tileBg the inset poster face so
             focus draws a real mint border instead of painting the tile. poster
             carries the artwork; with no uri it stays transparent and tileBg
             shows through. -->
        <Rectangle id="tileBorder" width="270" height="378" color="0x2BD67500">
            <Rectangle id="tileBg" width="262" height="370" translation="[4, 4]" color="0x0B110DFF" />
            <Poster id="poster" width="262" height="370" translation="[4, 4]" failBackgroundColor="0x0B110DFF" />
        </Rectangle>
    </children>
</component>
