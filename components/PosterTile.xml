<?xml version="1.0" encoding="utf-8"?>
<component name="PosterTile" extends="Group">
    <!-- MarkupGrid and RowList only update item components through these
         read-only interface fields (they never touch `content` or `focused`):
         itemContent carries the tile's ContentNode, itemHasFocus marks the
         focused item, and rowHasFocus tells a whole row that its list row has
         focus. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/PosterTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <!-- tileBorder is the frame (full tile), tileBg the inset poster face so
             focus draws a real mint border instead of painting the tile. poster
             carries the artwork; with no uri it stays transparent and tileBg
             shows through. titleText is the fallback for tiles that have no
             art (or whose art failed to load): hidden whenever a poster is
             showing. -->
        <Rectangle id="tileBorder" width="270" height="378">
            <Rectangle id="tileBg" width="262" height="370" translation="[4, 4]" />
            <Poster id="poster" width="262" height="370" translation="[4, 4]" />
            <Label id="titleText" width="246" height="362" translation="[18, 8]" horizAlign="center" vertAlign="middle" wrap="true" font="font:MediumSystemFont" />
            <BusySpinner
                id="loadSpinner"
                translation="[113, 163]"
                width="44"
                height="44"
                spinning="false" />
            <!-- Optional continue-watching progress bar, painted on top of the
                 poster's bottom edge (6px strip spanning the tile). The dark
                 track is the full tile width; the mint fill's width is scaled
                 in code from itemContent.progress (0..1). Both stay hidden
                 until a screen passes progress. -->
            <Rectangle id="progressTrack" width="262" height="8" translation="[4, 366]" visible="false" />
            <Rectangle id="progressFill" width="262" height="8" translation="[4, 366]" visible="false" />
            <!-- Optional watched-state glyph (eye = done, clock = in
                 progress), ~48px top-right above the bar. The uri is set in
                 code from itemContent.watchedGlyph; hidden until a screen asks
                 for a badge. -->
            <Poster id="watchedGlyph" width="48" height="48" translation="[214, 10]" visible="false" />
        </Rectangle>
    </children>
</component>
