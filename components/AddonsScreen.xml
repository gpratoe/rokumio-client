<?xml version="1.0" encoding="utf-8"?>
<component name="AddonsScreen" extends="Screen">
    <!-- Installed add-on manager. "Add add-on" chip on top; installed add-ons
         shown as rich cards below. Hybrid install: local setup URL shown in
         header and in the add dialog; manual manifest entry via keyboard dialog.
         Metadata, install, and remove behaviors preserved. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="SetSetupAddress" />
        <field id="addonRemoved" type="assocarray" />
        <field id="addonInstalled" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AddonsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />

    <children>
        <Rectangle id="addonsBg" width="1920" height="1080" color="0x000000FF" />

        <Label
            id="addonsTitle"
            translation="[80, 48]"
            width="900"
            height="60"
            font="font:LargeBoldSystemFont" />

        <MultiStyleLabel
            id="setupHeader"
            translation="[900, 56]"
            width="940"
            height="44"
            horizAlign="right"
            vertAlign="center"
            visible="false" />

        <ChipsRow id="addChipRow" translation="[160, 150]" />

        <RowList
            id="addonsList"
            translation="[160, 250]"
            numRows="1"
            itemSize="[1600, 332]"
            itemSpacing="[0, 12]"
            rowItemSize="[[1600, 320]]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="AddonCard" />

        <Label
            id="addonsStatus"
            translation="[80, 1012]"
            width="1760"
            height="40"
            horizAlign="center"
            font="font:SmallSystemFont" />
    </children>
</component>
