<?xml version="1.0" encoding="utf-8"?>
<component name="AddonsScreen" extends="Screen">
    <!-- Installed add-on manager. An "Add add-on" row installs by fetching a
         manifest URL (system KeyboardDialog), and every installed add-on below
         it can be removed through a confirmation dialog unless it is a
         protected built-in. The list is rebuilt from AddonsStore on every entry
         and after each install/remove. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AddonsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="addonsBg" width="1920" height="1080" color="0x0" />

        <Label
            id="addonsTitle"
            translation="[80, 48]"
            width="1760"
            height="70"
            text="Add-ons"
            font="font:LargeBoldSystemFont" />
        <Label
            id="addonsSub"
            translation="[80, 128]"
            width="1760"
            height="40"
            text="OK adds or removes an add-on, Back returns to Home"
            font="font:SmallSystemFont" />

        <ChevronList
            id="addonsList"
            translation="[80, 240]"
            numRows="5"
            itemWidth="1000"
            rowHeight="110" />

        <Label
            id="addonsStatus"
            translation="[80, 1000]"
            width="1760"
            height="40"
            font="font:SmallSystemFont" />
    </children>
</component>
