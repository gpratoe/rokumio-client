<?xml version="1.0" encoding="utf-8"?>
<component name="AddonsScreen" extends="Group">
    <!-- Installed add-on manager. An "Add add-on" row installs by fetching a
         manifest URL (system KeyboardDialog), and every installed add-on below
         it can be removed through a confirmation dialog unless it is a
         protected built-in. The list is rebuilt from AddonsStore on every entry
         and after each install/remove. -->
    <interface>
        <function name="SetStores" />
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AddonsScreen.brs" />

    <children>
        <Rectangle id="addonsBg" width="1920" height="1080" color="0x0A0F0CFF" />

        <Label
            id="addonsTitle"
            translation="[80, 48]"
            width="1760"
            height="70"
            text="Add-ons"
            font="font:LargeBoldSystemFont"
            color="0x2BD675FF" />
        <Label
            id="addonsSub"
            translation="[80, 128]"
            width="1760"
            height="40"
            text="OK adds or removes an add-on, Back returns to Home"
            font="font:SmallSystemFont"
            color="0x8FA399FF" />

        <RowList
            id="addonsList"
            translation="[80, 210]"
            numRows="3"
            itemSize="[1000, 118]"
            itemSpacing="[0, 8]"
            rowItemSize="[[1000, 110]]"
            showRowLabel="[false]"
            drawFocusFeedback="false"
            itemComponentName="PrefRow" />

        <Label
            id="addonsStatus"
            translation="[80, 620]"
            width="1760"
            height="40"
            font="font:SmallSystemFont"
            color="0x2BD675FF" />
    </children>
</component>