<?xml version="1.0" encoding="utf-8"?>
<component name="AddonsScreen" extends="Screen">
    <!-- Installed add-on manager. An "Add add-on" row installs by fetching a
         manifest URL (system KeyboardDialog), and every installed add-on below
         it can be removed through a confirmation dialog unless it is a
         protected built-in. The list is rebuilt from AddonsStore on every entry
         and after each install/remove. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <!-- main() starts the local setup page before this screen ever opens;
             the address lands here through the Scene's ShowSetupAddress. -->
        <function name="SetSetupAddress" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AddonsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="addonsBg" width="1920" height="1080" color="0x0" />

        <Label
            id="addonsTitle"
            translation="[80, 48]"
            width="1760"
            height="70"
            text="Add-ons"
            font="font:LargeBoldSystemFont" />
        <Label
            id="addonsSub"
            translation="[80, 128]"
            width="1760"
            height="40"
            text="OK adds or removes an add-on, Back returns to Home"
            font="font:SmallSystemFont" />

        <ChevronList
            id="addonsList"
            translation="[80, 240]"
            numRows="5"
            itemWidth="1000"
            rowHeight="110" />

       <Group id="companionPanel" translation="[1140, 140]">
            <Rectangle id="companionPlate" width="700" height="720" />
            <Label
                id="companionTitle"
                translation="[40, 36]"
                width="620"
                height="80"
                text="Add add-ons faster"
                horizAlign="center"
                font="font:MediumBoldSystemFont" />
            <Poster
                id="companionQr"
                translation="[185, 140]"
                width="330"
                height="330"
                uri="pkg:/images/qr-companion.png" />
            <Label
                id="companionCaption"
                translation="[40, 478]"
                width="620"
                height="140"
                horizAlign="center"
                wrap="true"
                text="Use our Android app to add add-ons faster — no need to type a manifest URL by hand."
                font="font:SmallSystemFont" />

            <!-- Address of the local setup page, at the bottom of the companion
                 card: the same "do this on your phone" job as the QR, but for
                 the page the channel itself serves — no companion app to
                 install. Hidden until main() publishes an address. -->
            <Label
                id="setupHint"
                translation="[40, 636]"
                width="620"
                height="30"
                horizAlign="center"
                visible="false"
                text="Or install from your browser:"
                font="font:SmallSystemFont" />
            <Label
                id="setupUrl"
                translation="[40, 672]"
                width="620"
                height="44"
                horizAlign="center"
                visible="false"
                font="font:MediumBoldSystemFont" />
        </Group>

        <Label
            id="addonsStatus"
            translation="[80, 1000]"
            width="1760"
            height="40"
            font="font:SmallSystemFont" />
    </children>
</component>
