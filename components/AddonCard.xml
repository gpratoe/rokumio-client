<?xml version="1.0" encoding="utf-8"?>
<component name="AddonCard" extends="Group">
    <!-- Wide rich add-on card (1400x320) for AddonsScreen. Uses scalable
         9-patch surfaces for the frame so width/layout can be tuned without
         fixed bitmap distortion. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AddonCard.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />

    <children>
        <Poster id="tileBorder" width="1600" height="320" uri="pkg:/images/chip.9.png">
            <Poster id="tileFace" width="1584" height="304" translation="[8, 8]" uri="pkg:/images/chip.9.png" />

            <Poster
                id="logoBg"
                uri="pkg:/images/chip.9.png"
                width="184"
                height="184"
                translation="[32, 68]" />
            <Poster
                id="addonLogo"
                translation="[52, 88]"
                width="144"
                height="144"
                loadWidth="144"
                loadHeight="144"
                loadDisplayMode="scaleToFit"
                uri="pkg:/images/puzzle.png"
                failedBitmapUri="pkg:/images/puzzle.png" />

            <LayoutGroup
                id="nameRow"
                translation="[244, 56]"
                layoutDirection="horiz"
                itemSpacings="[16]"
                vertAlignment="center">
                <Label
                    id="addonName"
                    height="46"
                    font="font:MediumBoldSystemFont" />
                <Label
                    id="addonVersion"
                    height="34"
                    font="font:SmallSystemFont" />
            </LayoutGroup>

            <Label
                id="addonScope"
                translation="[244, 106]"
                width="1020"
                height="32"
                font="font:SmallBoldSystemFont" />

            <Label
                id="addonDescription"
                translation="[244, 150]"
                width="1020"
                height="134"
                wrap="true"
                maxLines="3"
                font="font:SmallSystemFont" />

            <Label
                id="addonAction"
                translation="[1290, 118]"
                width="260"
                height="84"
                horizAlign="center"
                vertAlign="center"
                wrap="true"
                maxLines="2"
                font="font:MediumBoldSystemFont" />
        </Poster>
    </children>
</component>
