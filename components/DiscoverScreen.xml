<?xml version="1.0" encoding="utf-8"?>
<component name="DiscoverScreen" extends="Group">
    <!-- Discover: browse Cinemeta by filter. Three chips (Type · Chart · Genre)
         sit above a poster grid. OK on a chip opens a dropdown menu of the
         chip's options — Up/Down to move, OK to pick, Back to dismiss — so a
         wrong pick is an instant Back, never a full cycle. OK on a result
         publishes a pushRequest the Scene routes to Details. Available charts:
         Popular (top), New (year, this year's releases) and Featured
         (imdbRating). The genre chip is dropped while New is selected, since
         New's only filter is the year itself. -->
    <interface>
        <!-- The one action Discover reports upward: a push request. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="SetStores" />
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/DiscoverScreen.brs" />

    <children>
        <Rectangle id="discoverBg" width="1920" height="1080" color="0x0" />
        <Label
            id="discoverTitle"
            translation="[150, 48]"
            width="1760"
            height="70"
            text="Discover"
            font="font:LargeBoldSystemFont"
            color="0x2BD675FF" />
        <Label
            id="discoverSub"
            translation="[150, 128]"
            width="1760"
            height="40"
            text="OK on a chip to open its menu · Up/Down to reach the results · Back to exit · * Focus filters"
            font="font:SmallSystemFont"
            color="0x8FA399FF" />

        <Label
            id="discoverStatus"
            translation="[150, 176]"
            width="1760"
            height="40"
            font="font:SmallSystemFont"
            color="0x2BD675FF" />

        <!-- The filter chips, one row of ChipTiles rebuilt whenever a value
             changes. The genre chip is omitted while chart = New. -->
        <RowList
            id="discoverChips"
            translation="[150, 232]"
            numRows="1"
            itemSize="[1760, 56]"
            itemSpacing="[0, 8]"
            rowItemSize="[[260, 56]]"
            rowItemSpacing="[[12, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="ChipTile" />

        <!-- Current filter summary, e.g. "Featured · Movies · Sci-Fi". -->
        <Label
            id="discoverHeader"
            translation="[150, 300]"
            width="1760"
            height="40"
            font="font:MediumSystemFont"
            color="0x8FA399FF" />

        <!-- Results grid: one fetch's metas chunked into poster rows of 6 so
             the RowList clips/scrolls vertically. Same PosterTile contract as
             Home's grid. -->
        <RowList
            id="discoverGrid"
            translation="[150, 342]"
            numRows="2"
            itemSize="[1780, 400]"
            itemSpacing="[0, 8]"
            rowItemSize="[[270, 378]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="PosterTile" />

        <!-- The dropdown: a panel below the chips listing one chip's options in
             a single-column RowList (vertical clipping free). Opens on chip OK;
             the panel is declared last so the menu paints over the grid. -->
        <Group id="discoverMenuGroup" translation="[150, 300]" visible="false">
            <Rectangle id="discoverMenuBackdrop" width="252" height="62" color="0x101813FF" />
            <RowList
                id="discoverMenu"
                numRows="1"
                itemSize="[248, 56]"
                itemSpacing="[0, 6]"
                rowItemSize="[[240, 56]]"
                rowItemSpacing="[[4, 0]]"
                showRowLabel="false"
                drawFocusFeedback="false"
                itemComponentName="ChipTile"
                vertFocusAnimationStyle="floatingFocus"/>
        </Group>
    </children>
</component>
