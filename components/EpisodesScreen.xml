<?xml version="1.0" encoding="utf-8"?>
<component name="EpisodesScreen" extends="Screen">
    <!-- The dedicated episode browser for a series. Pushed from DetailsScreen
         ("Episodes") with { addonAddress, meta, resume }. A Home-style RowList
         shows one row per season (tiles are episodes); the top header tracks the
         focused episode's "S#E# name" and synopsis. OK on an episode reports a
         stream-push request upward. -->
    <interface>
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/EpisodesScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="epBg" width="1920" height="1080" color="0x0" />
        <Poster id="bgPoster" width="1920" height="1080" loadDisplayMode="scaleToCrop" />
        <Rectangle id="bgScrim" width="1920" height="1080" />
        <Poster id="bgMask" width="1920" height="1080" loadDisplayMode="scaleToCrop" uri="pkg:/images/mask.png" />
        <!-- Header: series name, then the focused episode's label and synopsis. -->
        <Label
            id="epName"
            translation="[80, 48]"
            width="1760"
            height="70"
            horizAlign="left"
            font="font:LargeBoldSystemFont" />
        <Label
            id="epTitle"
            translation="[80, 128]"
            width="1760"
            height="40"
            font="font:MediumBoldSystemFont" />
        <Label
            id="epDesc"
            translation="[80, 172]"
            width="1760"
            height="118"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont" />

        <!-- Episode rows: one row per season, tiles are landscape EpisodeTiles.
             Content is built in code from the series meta. -->
        <RowList
            id="epList"
            translation="[80, 406]"
            numRows="2"
            itemSize="[1760, 230]"
            itemSpacing="[0, 8]"
            rowItemSize="[[320, 180]]"
            rowItemSpacing="[[12, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[0, 0]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="false"
            itemComponentName="EpisodeTile"
            vertFocusAnimationStyle="fixedFocusWrap"
          wrapDividerBitmapUri="pkg:/images/divider.9.png"/>
    </children>
</component>
