<?xml version="1.0" encoding="utf-8"?>
<component name="StreamTile" extends="Group">
    <!-- Wide stream card for StreamsScreen's list. RowList feeds each item its
         ContentNode through itemContent (title + description — real Content
         Meta-Data fields, unlike subtitle). The tile splits the multi-line
         description at its line feeds itself, so it can show as many lines as
         the title actually carries. Focus drives through itemHasFocus /
         rowHasFocus. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <!-- tileBorder is the frame, tileFace the inset face so focus draws a
             real mint frame instead of painting over the card. -->
        <Rectangle id="tileBorder" width="1080" height="280">
            <Rectangle id="tileFace" width="1072" height="270" translation="[4, 4]" />
            <ScrollingLabel
                id="tileTitle"
                maxWidth="1040"
                height="40"
                clippingRect="[0, 0, 1040, 40]"
                translation="[18, 32]"
                horizAlign="left"
                vertAlign="center" />
            <ScrollingLabel
                id="tileLine1"
                maxWidth="1040"
                height="34"
                clippingRect="[0, 0, 1040, 34]"
                translation="[18, 92]"
                horizAlign="left"
                vertAlign="center" />
            <ScrollingLabel
                id="tileLine2"
                maxWidth="1040"
                height="34"
                clippingRect="[0, 0, 1040, 34]"
                translation="[18, 130]"
                horizAlign="left"
                vertAlign="center" />
            <ScrollingLabel
                id="tileLine3"
                maxWidth="1040"
                height="34"
                clippingRect="[0, 0, 1040, 34]"
                translation="[18, 168]"
                horizAlign="left"
                vertAlign="center" />
            <ScrollingLabel
                id="tileLine4"
                maxWidth="1040"
                height="34"
                clippingRect="[0, 0, 1040, 34]"
                translation="[18, 206]"
                horizAlign="left"
                vertAlign="center" />
            <ScrollingLabel
                id="tileLine5"
                maxWidth="1040"
                height="34"
                clippingRect="[0, 0, 1040, 34]"
                translation="[18, 244]"
                horizAlign="left"
                vertAlign="center" />
        </Rectangle>
    </children>
</component>
