<?xml version="1.0" encoding="utf-8"?>
<component name="StreamTile" extends="Group">
    <!-- Wide stream card for StreamsScreen's list. RowList feeds each item its
         ContentNode through itemContent (title + description — real Content
         Meta-Data fields, unlike subtitle). The tile splits the multi-line
         description at its line feeds itself, so it can show as many lines as
         the title actually carries. Focus drives through itemHasFocus /
         rowHasFocus. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamTile.brs" />

    <children>
        <!-- tileBorder is the frame, tileFace the inset face so focus draws a
             real mint frame instead of painting over the card. -->
        <Rectangle id="tileBorder" width="1080" height="300" color="0x2BD67500">
            <Rectangle id="tileFace" width="1072" height="292" translation="[4, 4]" color="0x0B110DFF" />
            <Label
                id="tileTitle"
                width="1040"
                height="40"
                translation="[18, 32]"
                horizAlign="left"
                vertAlign="center"
                font="font:MediumBoldSystemFont"
                color="0xE9F2ECFF" />
            <Label
                id="tileLine1"
                width="1040"
                height="34"
                translation="[18, 92]"
                horizAlign="left"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0xE9F2ECFF" />
            <Label
                id="tileLine2"
                width="1040"
                height="34"
                translation="[18, 130]"
                horizAlign="left"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0x8FA399FF" />
            <Label
                id="tileLine3"
                width="1040"
                height="34"
                translation="[18, 168]"
                horizAlign="left"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0x8FA399FF" />
            <Label
                id="tileLine4"
                width="1040"
                height="34"
                translation="[18, 206]"
                horizAlign="left"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0x8FA399FF" />
            <Label
                id="tileLine5"
                width="1040"
                height="34"
                translation="[18, 244]"
                horizAlign="left"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0x8FA399FF" />
        </Rectangle>
    </children>
</component>