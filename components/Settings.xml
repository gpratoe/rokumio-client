<?xml version="1.0" encoding="utf-8"?>
<component name="Settings" extends="Group">
    <!-- The Settings screen owns its whole visible region: the tab chips, the
         row list, and the detail panel. It keeps its own focus and handles its
         own keys, and only talks to MainScene through this interface, so none
         of its internals leak into MainScene's flat onKeyEvent.

         Inputs (MainScene -> Settings):
           - visible (inherited Group field): MainScene shows/hides the screen and
                         the component observes it to render + focus on show.
           - state:    assocarray of current values the rows render from. MainScene
                         is the source of truth for these, so it pushes a fresh
                         state after any row action that changed one.
         Outputs (Settings -> MainScene):
           - action:     { type, payload } for a row the user pressed OK on. MainScene
                         dispatches it to the shared services/persistence. Back is
                         NOT reported here: the component returns false for back and
                         MainScene owns leaving the screen.
           - screenInfo:  { tabIndex, title, subtitle, heroTitle, heroDescription }
                         so MainScene can update its shared chrome (the header and
                         hero labels live outside this component). MainScene also
                         mirrors tabIndex because a * (options) press on the
                         Settings screen is handled at the scene level. -->
    <interface>
        <field id="state" type="assocarray" alwaysNotify="true" onChange="onStateChanged" />
        <field id="focusRequest" type="boolean" onChange="onFocusRequest" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="screenInfo" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/Locale.brs" />
    <script type="text/brightscript" uri="pkg:/components/Settings.brs" />

