<?xml version="1.0" encoding="utf-8"?>
<component name="SearchScreen" extends="Screen">
    <!-- Search: a Netflix-style split pane. The left column is a nav-style
         query box (chip face, query text, mic glyph) above a compact
         keyboard (the SearchKeyboard extension of DynamicMiniKeyboard, which
         is what makes the pane escapable — see that component's header). Its
         own text field is hidden; voice entry still works through the
         remote's mic button. Every settled keystroke fans the query out to
         every search-capable catalog across all installed add-ons; results
         land as poster rows on the right, one per search-capable catalog
         (rows appear only for catalogs that returned results). OK on a
         result publishes a pushRequest the Scene routes to Details. The *
         (options) key toggles between the panes. -->
    <interface>
        <!-- The one action Search reports upward: a push request. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />

    <children>
        <Rectangle id="searchBg" width="1920" height="1080" color="0x0" />

        <!-- Live-search debounce: every keystroke restarts this window, so a
             typed word fans out once, not per letter, and stale tasks are
             reaped along the way (see onQueryChanged). -->
        <Timer id="queryDebounce" duration="0.7" repeat="false" />
        <!-- One-shot geometry check: the key grid builds from its Key
             Definition File off the render thread, so its painted width is
             only known a beat after init; FitKeyboard scales the keyboard
             down if it would cross into the results pane. -->
        <Timer id="keyboardFit" duration="0.25" repeat="false" />

        <!-- The left pane, nav-style: the keyboard's own VoiceTextEditBox is
             the query box (it draws the text field and its mic icon and
             voice hints natively — the configuration the OS routes remote
             voice dictation to), with the key grid below it. Hiding the box
             (hideTextBox) was tried and breaks voice: the OS ignores hidden
             voice fields and falls through to the system-wide search. The
             keyboard's colors are assigned in init() through the key grid's
             palette field (an RSGPalette must never be an ancestor of
             rendered content: it is non-renderable, and the render
             traversal skips it and everything under it). -->
        <Group id="keyboardPane" translation="[90, 90]">
            <!-- Pane backdrop: separates the keyboard section from the
                 results; sized to the keyboard's painted width in
                 FitKeyboard. -->
            <Poster
                id="paneBg"
                translation="[-16, -16]"
                width="632"
                height="700"
                loadWidth="632"
                loadHeight="700"
                loadDisplayMode="limitSize"
                uri="pkg:/images/chip.9.png" />
            <SearchKeyboard
                id="searchKeyboard"
                translation="[0, 0]"
                domain="generic" />
        </Group>

        <!-- Right pane: the status line and a quiet empty-state hint share
             the spot above the results rows; visibility decides who shows. -->
        <Label
            id="searchHint"
            translation="[750, 96]"
            width="1080"
            height="40"
            font="font:SmallSystemFont"
            visible="false" />
        <Label
            id="searchStatus"
            translation="[750, 96]"
            width="1080"
            height="40"
            font="font:SmallSystemFont" />

        <!-- Results rows, one per search-capable catalog that returned
             results. numRows is set from m.rows; nothing is premised, so the
             list can start empty and fill in as add-ons answer. -->
        <RowList
            id="searchResults"
            translation="[750, 150]"
            numRows="2"
            itemSize="[1080, 405]"
            itemSpacing="[0, 66]"
            rowItemSize="[[270, 405]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[0, 10]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
    </children>
</component>
