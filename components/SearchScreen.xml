<?xml version="1.0" encoding="utf-8"?>
<component name="SearchScreen" extends="Screen">
    <!-- Search: every installed add-on's search-capable catalogs. A
         KeyboardDialog prompt on entry, then results as poster rows, one per
         search-capable catalog (Stremio-style). OK on a result publishes a
         pushRequest the Scene routes to Details. The * (options) key reopens
         the keyboard prefilled with the last query. -->
    <interface>
        <!-- The one action Search reports upward: a push request. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />

    <children>
        <Rectangle id="searchBg" width="1920" height="1080" color="0x0" />
        <Label
            id="searchTitle"
            translation="[150, 48]"
            width="1760"
            height="70"
            text="Search"
            font="font:LargeBoldSystemFont" />
        <Label
            id="searchSub"
            translation="[150, 128]"
            width="1760"
            height="40"
            text="Type a title, then OK · * to search again · Back to exit"
            font="font:SmallSystemFont" />

        <Label
            id="searchStatus"
            translation="[150, 180]"
            width="1760"
            height="40"
            font="font:SmallSystemFont" />

        <!-- Results grid: poster rows, one per catalog that returned results.
             numRows is set from m.rows; a catalog with no matches gets no row,
             so the grid can start empty and fill in as add-ons answer. -->
        <RowList
            id="searchResults"
            translation="[150, 230]"
            numRows="2"
            itemSize="[1780, 405]"
            itemSpacing="[0, 66]"
            rowItemSize="[[270, 405]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[0, 10]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
    </children>
</component>
