<component name="FilterBar" extends="Group" focusable="true">

    <!-- FilterBar — a filter-chip row with a pull-down option menu, shared by
         DiscoverScreen and LibraryScreen. The chips are one ChipsRow; OK on a
         chip opens the dropdown for it under that chip; Up/Down move inside
         the menu, OK picks, Back/options dismisses without changing anything.
         The screen supplies the option data and the commit effect; the
         component owns the row, the dropdown geometry, the focus hand-off,
         and the menu-open key guard.

         Interface:
           chipActivated (int)   — fires with the chip index when OK is
                                   pressed on a chip; the screen answers with
                                   ShowMenu(options, currentIndex).
           optionPicked (AA)     — fires {chip, index} when OK is pressed on a
                                   menu row; the screen resolves the raw value
                                   and commits its effect.
           SetChips(entries)     — rebuild the chip row {raw,label} list,
                                   preserving the focused chip.
           ShowMenu(options, run)
           HideMenu()            — dismiss + refocus the chips.
           FocusChips()          — keyboard-navigation escape to the chips.
           FocusIsOnChips()      — the chips hold focus (screen arrow grants).
           IsMenuOpen()          — guard for entry-time resets.
         Geometry is rooted at the component itself, which each screen places
         where its chips row lives (translation [150,232]); the dropdown hangs
         68px below (absolute y 300). -->

    <interface>
        <field id="chipActivated" type="int" value="-1" alwaysNotify="true" />
        <field id="optionPicked" type="assocarray" alwaysNotify="true" />
        <field id="chipItemWidth" type="int" value="260" />
        <field id="chipItemHeight" type="int" value="72" />
        <field id="menuItemHeight" type="int" value="56" />
        <function name="SetChips" />
        <function name="ShowMenu" />
        <function name="HideMenu" />
        <function name="FocusChips" />
        <function name="BlurChips" />
        <function name="FocusIsOnChips" />
        <function name="IsMenuOpen" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/FilterBar.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <ChipsRow id="chips" />

        <!-- The dropdown: a panel below the chips listing one chip's options.
             Built as a manual list (nav-rail pattern) for snappy focus/scroll. -->
        <Group id="menuGroup" visible="false">
            <Rectangle id="menuBackdrop" width="260" height="56" />
            <Group id="menuList" />
            <Poster
                id="menuMore"
                width="24"
                height="24"
                loadWidth="24"
                loadHeight="24"
                loadDisplayMode="scaleToFit"
                uri="pkg:/images/chevron-down.png"
                visible="false" />
        </Group>
    </children>
</component>
