<?xml version="1.0" encoding="utf-8"?>
<component name="LibraryScreen" extends="Screen">
    <!-- Library: the saved items for the current session, browsed in the same
         hero-led style as Discover. A Home-style hero reflects the focused saved
         item (poster backdrop + title; saved records are slim, so fields they
         don't carry — logo, description, rating, genres — simply stay hidden and
         the hero degrades gracefully). Two filter chips (Type · Sort) sit above
         a poster grid: OK on a chip opens its dropdown, OK on a tile pushes
         Details. All data is local to LibraryStore, so nothing is fetched; a
         filter/sort change only re-slices what is already there. -->
    <interface>
        <!-- The one action Library reports upward: a push request. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             RefreshRows is the Scene's poke to re-slice after a background
             library sync lands while this screen is top. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="RefreshRows" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/LibraryScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/HeroFit.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Hero.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />

    <children>
        <Rectangle id="libraryBg" width="1920" height="1080" color="0x0" />
        <Timer id="heroTitleGrace" duration="0.18" repeat="false" />

        <Poster
            id="heroPoster"
            translation="[0, 0]"
            width="1920"
            height="1080"
            loadWidth="1920"
            loadHeight="1080"
            loadDisplayMode="scaleToZoom"
            opacity="1.0" />
        <Rectangle
            id="heroScrim"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x00000099" />
        <Poster
            id="heroMask"
            translation="[0, 320]"
            width="1920"
            height="760"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/mask.png" />

        <Label
            id="libraryStatus"
            translation="[150, 20]"
            width="1620"
            height="34"
            font="font:SmallSystemFont" />

        <Poster
            id="heroLogo"
            translation="[162, 72]"
            width="820"
            height="460"
            loadWidth="820"
            loadHeight="460"
            loadDisplayMode="scaleToFit"
            visible="false" />
        <Label
            id="heroTitle"
            translation="[162, 112]"
            width="680"
            height="90"
            wrap="true"
            font="font:LargeBoldSystemFont" />
        <Label
            id="heroMeta"
            translation="[166, 216]"
            width="900"
            height="30"
            font="font:SmallSystemFont" />
        <Group id="heroRating" translation="[166, 256]" visible="false">
            <Poster
                id="heroImdbLogo"
                width="64"
                height="32"
                loadWidth="64"
                loadHeight="32"
                loadDisplayMode="scaleToFit"
                uri="pkg:/images/imdb.png" />
            <Label
                id="heroRatingText"
                translation="[76, 0]"
                width="110"
                height="36"
                vertAlign="center"
                font="font:LargeBoldSystemFont" />
        </Group>
        <Label
            id="heroGenres"
            translation="[166, 307]"
            width="860"
            height="32"
            font="font:SmallSystemFont" />
        <Label
            id="heroDescription"
            translation="[166, 357]"
            width="860"
            height="145"
            wrap="true"
            vertAlign="top"
            font="font:SmallSystemFont" />

        <!-- Saved items chunked into poster rows of 6 so the RowList
             clips/scrolls vertically. Same PosterTile contract as Home and
             Discover. -->
        <RowList
            id="libraryGrid"
            translation="[90, 632]"
            numRows="2"
            itemSize="[1800, 405]"
            itemSpacing="[0, 18]"
            rowItemSize="[[270, 405]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="false"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />

        <!-- Filter chips + dropdown (FilterBar), Discover-style long chips.
             Declared last so the dropdown paints over the results grid. -->
        <FilterBar id="filterBar" translation="[90, 552]" chipItemWidth="320" chipItemHeight="48" menuItemHeight="48" />

        <!-- Contextual shortcut hint: the asterisk keycap, shown only while
             grid focus is past the first row, where Up is consumed by the
             RowList and the asterisk key is the only way back to the filters. -->
        <Poster
            id="filtersHint"
            translation="[30, 554]"
            width="44"
            height="44"
            loadWidth="44"
            loadHeight="44"
            loadDisplayMode="limitSize"
            uri="pkg:/images/asterisk.png"
            visible="false"
            opacity="0" />

        <Animation id="filtersHintFade" duration="0.2" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator
                id="filtersHintFadeInterp"
                fieldToInterp="filtersHint.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
        </Animation>

        <Animation id="heroPosterFadeAnim" duration="0.2" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator
                id="heroPosterFadeInterp"
                fieldToInterp="heroPoster.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
        </Animation>

        <!-- Empty-state message, centered in the results area when the current
             filter/sort yields no saved items. -->
        <Label
            id="libraryEmpty"
            translation="[90, 720]"
            width="1740"
            height="90"
            horizAlign="center"
            vertAlign="center"
            wrap="true"
            visible="false"
            font="font:MediumSystemFont" />
    </children>
</component>
