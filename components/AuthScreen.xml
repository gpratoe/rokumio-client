<?xml version="1.0" encoding="utf-8"?>
<component name="AuthScreen" extends="Group">
    <!-- First-run / post-logout decision screen: browse as a guest or log in
         with Stremio. A two-row PrefRow list; OK publishes a pushRequest the
         Scene routes. "Continue as guest" lands in Stage 1; "Log in with
         Stremio" is wired once the link-code flow exists. -->
    <interface>
        <!-- The one action AuthScreen reports upward: a choice request the
             Scene routes. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             Stores are class instances and cannot cross components through a
             field, so they arrive via callFunc. -->
        <function name="SetStores" />
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/AuthScreen.brs" />

    <children>
        <Rectangle id="authBg" width="1920" height="1080" color="0x0" />
        <Label
            id="authTitle"
            translation="[80, 340]"
            width="1760"
            height="70"
            text="Rokumio"
            font="font:LargeBoldSystemFont"
            color="0x2BD675FF" />
        <Label
            id="authSub"
            translation="[80, 420]"
            width="1760"
            height="60"
            text="Browse as a guest, or log in with Stremio to sync your add-ons and library"
            font="font:MediumSystemFont"
            color="0x8FA399FF" />

        <RowList
            id="authList"
            translation="[80, 500]"
            numRows="2"
            itemSize="[1000, 118]"
            itemSpacing="[0, 8]"
            rowItemSize="[[1000, 110]]"
            showRowLabel="[false]"
            drawFocusFeedback="false"
            itemComponentName="PrefRow"
            vertFocusAnimationStyle="floatingFocus"/>
    </children>
</component>
