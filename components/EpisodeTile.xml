<?xml version="1.0" encoding="utf-8"?>
<component name="EpisodeTile" extends="Group">
    <!-- Landscape episode cell for EpisodesScreen's season rows. RowList and
         MarkupGrid only update item components through the read-only interface
         fields itemContent / itemHasFocus / rowHasFocus (they never touch
         `content` or `focused`). Artwork comes from the episode thumbnail; with
         no art the S#E#/name text shows through so the cell is never blank. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/EpisodeTile.brs" />

    <children>
        <!-- tileBorder is the frame (full tile), tileBg the inset face so focus
             draws a real mint frame instead of painting over the tile. poster
             carries the thumbnail; with no uri it stays transparent and tileBg
             shows through. titleText is the fallback for tiles with no art (or
             whose art failed to load): hidden whenever art is showing. -->
        <Rectangle id="tileBorder" width="320" height="180" color="0x2BD67500">
            <Rectangle id="tileBg" width="312" height="172" translation="[4, 4]" color="0x0B110DFF" />
            <Poster id="poster" width="312" height="172" translation="[4, 4]" failBackgroundColor="0x0B110DFF" />
            <Label id="titleText" width="296" height="164" translation="[12, 8]" horizAlign="center" vertAlign="middle" wrap="true" font="font:MediumSystemFont" color="0xE9F2ECFF" />
        </Rectangle>
    </children>
</component>