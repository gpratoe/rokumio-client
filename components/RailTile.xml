<?xml version="1.0" encoding="utf-8"?>
<component name="RailTile" extends="Group">
    <!-- Wide icon tile for the Home left rail, standalone (no RowList): the
         rail is a Group of these, focused one at a time. Collapsed, the icon
         sits centered; expanded, it steps left and the section name shows on
         every tile. No per-tile background: the rail is the surface. -->
    <interface>
        <field id="focused" type="boolean" alwaysNotify="true" />
        <field id="expanded" type="boolean" alwaysNotify="true" />
        <function name="SetTile" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/RailTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Timer id="stepTimer" duration="0.016" repeat="true" />

        <Poster
            id="railGlyph"
            width="48"
            height="48"
            loadWidth="48"
            loadHeight="48"
            loadDisplayMode="limitSize"
            translation="[32, 16]" />
        <Label
            id="railLabel"
            translation="[84, 16]"
                width="228"
                height="48"
                vertAlign="center"
                scaleRotateCenter="[0, 40]"
                font="font:MediumSystemFont"
                visible="false" />
    </children>
</component>
