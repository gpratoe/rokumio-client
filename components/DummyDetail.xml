<?xml version="1.0" encoding="utf-8"?>
<component name="DummyDetail" extends="Group">
    <interface>
        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             callFunc only runs for functions declared in the interface. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="BlurFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/DummyDetail.brs" />

    <children>
        <Rectangle id="detailBg" width="1920" height="1080" color="0x101813FF" />
        <Label
            id="detailTitle"
            translation="[80, 80]"
            width="1760"
            height="70"
            font="font:LargeBoldSystemFont"
            color="0xE9F2ECFF" />
        <Label
            id="detailMeta"
            translation="[80, 170]"
            width="1760"
            height="40"
            font="font:SmallSystemFont"
            color="0x8FA399FF" />
        <Label
            id="detailHint"
            translation="[80, 240]"
            width="1760"
            height="40"
            font="font:SmallSystemFont"
            color="0x8FA399FF"
            text="M1 dummy — Back pops to Home and focuses the same poster" />
    </children>
</component>