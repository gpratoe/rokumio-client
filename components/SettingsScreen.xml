<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsScreen" extends="Screen">
    <!-- App preferences, grouped into sections: one chip per section along the
         top, the options of the selected section below. Values are persisted
         through SettingsStore. Editing the server address opens a system
         KeyboardDialog; the language row cycles its options on OK. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/TorrentProfile.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/CacheSize.brs" />

    <children>
        <Rectangle id="settingsBg" width="1920" height="1080" color="0x0" />

        <!-- Section chips. The selected section is marked `active` (dimmed) so
             the chip row and the options below agree on which section is shown. -->
        <ChipsRow id="settingsChips" translation="[80, 60]" />

        <!-- Options for the selected section (custom focusable rows, no RowList).
             Rows are windowed into the visible area with chevron indicators when
             content extends above/below. -->
        <Group id="optionsArea" translation="[80, 150]">
            <Poster
                id="chevronUp"
                uri="pkg:/images/chevron-up.png"
                width="48"
                height="28"
                translation="[476, -36]"
                visible="false" />
            <Group id="optionsClip" translation="[0, 0]" clippingRect="[0, 0, 1000, 708]" />
            <Poster
                id="chevronDown"
                uri="pkg:/images/chevron-down.png"
                width="48"
                height="28"
                translation="[476, 716]"
                visible="false" />
        </Group>

        <!-- Side panel: follows the focused row and explains it. -->
        <Group id="infoPanel" translation="[1140, 150]">
            <Rectangle id="infoPlate" width="700" height="760" />
            <Label
                id="infoTitle"
                translation="[40, 30]"
                width="620"
                height="60"
                horizAlign="center"
                font="font:MediumBoldSystemFont" />
            <Label
                id="infoWarn"
                translation="[40, 92]"
                width="620"
                height="34"
                horizAlign="center"
                visible="false"
                font="font:SmallSystemFont" />
            <!-- MultiStyleLabel so codec names can be bold inside the sentence;
                 styles are set in code from the theme. -->
            <MultiStyleLabel
                id="infoBody"
                translation="[40, 140]"
                width="620"
                height="580"
                horizAlign="center"
                vertAlign="top"
                wrap="true" />
        </Group>

        <!-- Status line below the options window. -->
        <Label
            id="settingsStatus"
            translation="[80, 940]"
            width="1760"
            height="40"
            font="font:SmallSystemFont" />
    </children>
</component>
